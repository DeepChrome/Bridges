# Generated databases and working copies — all rebuildable from tools/
data/corpus.db
data/lexicon.db
data/examples.db
data/topics.db
data/audio.json
# Wiktionary's senses, built by ingest_wiktionary.py from the 890 MB extract in
# data/raw. Same class as lexicon.db, which is also generated from a re-fetchable
# dump and also ignored: 11.6 MB of derived data is not a source.
data/senses.db
data/orphans/
data/_work/

# Downloaded source dumps (re-fetchable; OpenRussian is ~22 MB)
data/raw/

# Generated page (3.5 MB, rebuilt by tools/build_site.py)
site/

# Netlify link state contains the project id
.netlify/

# Never commit deploy credentials
.env
*.token
backend/.dev.vars
backend/.wrangler/
native/.env

__pycache__/
node_modules/
tools/_*.js
tools/_*.py
tools/shots/
site/audio/

native/node_modules/
native/.expo/
# Generated by `expo prebuild`; EAS regenerates them from app.json on every build.
native/android/
native/ios/
# Every part of the native payload, ignored for one reason: build_site.py writes
# it from the databases, and a copy in git is a second answer to "what does the
# app ship". listening.json and senses.json were tracked while their four
# siblings were not - no rule, just the order they were added - which is how a
# clone comes to build differently from the machine that made it.
# NATIVE_PARTS in build_site.py is the list.
native/assets/data.json
native/assets/deep.json
native/assets/sent.json
native/assets/videos.json
native/assets/listening.json
native/assets/senses.json
.expo-export/
native/coverage/
data/raw/subs/
data/transcripts.json
data/listening.json

# emulator walkthrough screenshots (native/tools/walk.ps1)
native/screenshots/

# locally built APKs (native/tools/README: gradlew assembleRelease), ~190 MB
native/build-out/

# The scenario tracks and their require map are stitched from data/scenario_audio
# by tools/build_scene_tracks.mjs, which needs only ffmpeg. The clips themselves
# are committed: they were bought, and buying them again costs money.
native/assets/scenes/
native/src/scenetracks.js
