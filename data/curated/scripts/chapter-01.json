    { "id": "c", "ru": "Олег", "en": "Oleg" }
   ],
   "lines": [
    { "s": "a", "ru": "Иван, это ты?", "en": "Ivan, is that you?" },
    { "s": "b", "ru": "Да, Аня, это я.", "en": "Yes, Anya, it is me." },
    { "s": "a", "ru": "А кто это?", "en": "And who is that?" },
    { "s": "b", "ru": "Это Олег.", "en": "That is Oleg." },
    { "s": "a", "ru": "Олег? А где он?", "en": "Oleg? And where is he?" },
    { "s": "b", "ru": "Он не тут.", "en": "He is not here." },
    { "s": "a", "ru": "Он уже здесь?", "en": "Is he here yet?" },
    { "s": "b", "ru": "Нет, ещё нет.", "en": "No, not yet." },
    { "s": "a", "ru": "А где же он?", "en": "So where is he?" },
    { "s": "b", "ru": "Он там.", "en": "He is over there." },
    { "s": "a", "ru": "Вот он, Иван!", "en": "There he is, Ivan!" },
    { "s": "b", "ru": "Да, это он.", "en": "Yes, that is him." },
    { "s": "a", "ru": "Олег, ты уже здесь!", "en": "Oleg, you are here already!" },
    { "s": "c", "ru": "Я тут. Это я.", "en": "I am here. It is me." },
    { "s": "b", "ru": "А мы тут, Олег.", "en": "And we are here, Oleg." },
    { "s": "c", "ru": "Все тут. Вот и все.", "en": "Everyone is here. That is all of us." }
   ],
   "questions": [
