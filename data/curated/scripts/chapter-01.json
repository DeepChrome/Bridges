  "core1:1": {
   "title": "Who is coming with us",
   "cast": [
    { "id": "a", "ru": "Маша", "en": "Masha" },
    { "id": "b", "ru": "Олег", "en": "Oleg" },
    { "id": "c", "ru": "Пётр", "en": "Pyotr" }
   ],
   "lines": [
    { "s": "b", "ru": "Маша, ты с нами?", "en": "Masha, are you with us?" },
    { "s": "a", "ru": "А кто это — вы?", "en": "And who is this \"us\"?" },
    { "s": "b", "ru": "Я, Иван и Аня.", "en": "Me, Ivan and Anya." },
    { "s": "a", "ru": "Иван тоже с вами?", "en": "Ivan is with you too?" },
    { "s": "b", "ru": "Да, и он с нами.", "en": "Yes, he is with us as well." },
    { "s": "a", "ru": "А этот? Кто он?", "en": "And this one? Who is he?" },
    { "s": "b", "ru": "Этот? Это Пётр.", "en": "This one? That is Pyotr." },
    { "s": "a", "ru": "Пётр не с вами?", "en": "Pyotr is not with you?" },
    { "s": "c", "ru": "Я не с вами.", "en": "I am not with you." },
    { "s": "a", "ru": "Пётр! Ты тут?", "en": "Pyotr! You are here?" },
    { "s": "c", "ru": "Тут. Но я уже там.", "en": "Here. But I am already on my way there." },
    { "s": "b", "ru": "Он уже там, Маша.", "en": "He is already there, Masha." },
    { "s": "a", "ru": "А, вот как, Олег.", "en": "Ah, I see, Oleg." },
    { "s": "b", "ru": "Так что, ты с нами?", "en": "So then, are you coming with us?" },
    { "s": "a", "ru": "Да, я с вами.", "en": "Yes, I am with you." }
   ],
   "questions": [
    { "ask": "Who does Oleg name as coming with him?",
      "options": ["Ivan and Anya", "Pyotr and Anya", "Only Ivan", "Nobody"], "answer": 0 },
    { "ask": "Why is Pyotr not with them?",
      "options": ["He is already on his way there", "He is ill", "He was not asked", "He is with Anya"],
      "answer": 0 },
    { "ask": "What does Masha want to know first?",
      "options": ["Who \"us\" means", "Where they are going", "When they leave", "Whether Oleg is driving"],
      "answer": 0 },
    { "ask": "What does Masha decide?",
      "options": ["She goes with them", "She stays behind", "She goes with Pyotr", "She cannot decide"],
      "answer": 0 },
    { "ask": "Who answers for himself, unasked?",
      "options": ["Pyotr", "Ivan", "Oleg", "Nobody does"], "answer": 0 }
   ]
  },

