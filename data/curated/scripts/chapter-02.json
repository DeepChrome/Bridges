   ],
   "lines": [
    { "s": "b", "ru": "Аня, ты обедаешь?", "en": "Anya, are you having lunch?" },
    { "s": "a", "ru": "Обедаю. А ты, Олег?", "en": "I am. And you, Oleg?" },
    { "s": "b", "ru": "Я уже. Я только кофе.", "en": "I already have. Just coffee for me." },
    { "s": "a", "ru": "Кофе? А пиво?", "en": "Coffee? What about a beer?" },
    { "s": "b", "ru": "Пиво? Это не для дня.", "en": "Beer? Not in the daytime." },
    { "s": "a", "ru": "Так что ты закажешь?", "en": "So what will you order?" },
    { "s": "b", "ru": "Кофе. Только кофе.", "en": "Coffee. Only coffee." },
    { "s": "a", "ru": "А я хочу пробовать всё.", "en": "And I want to try everything." },
    { "s": "b", "ru": "Всё? Так не делают.", "en": "Everything? That is not how it is done." },
    { "s": "a", "ru": "Делают. Я так делаю.", "en": "It is. I do it that way." },
    { "s": "b", "ru": "А ужинать? Ты ужинаешь?", "en": "And dinner? Do you have dinner?" },
    { "s": "a", "ru": "Ужинаю. Но уже не тут.", "en": "I do. But not here." },
    { "s": "b", "ru": "Не тут? А где?", "en": "Not here? Where then?" },
    { "s": "a", "ru": "У себя. Одна.", "en": "At my own place. On my own." }
