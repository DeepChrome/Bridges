  "food:1": {
   "title": "Bread, butter and cake",
   "cast": [
    { "id": "a", "ru": "Катя", "en": "Katya" },
    { "id": "b", "ru": "Борис", "en": "Boris" },
    { "id": "c", "ru": "Аня", "en": "Anya" }
   ],
   "lines": [
    { "s": "a", "ru": "Борис, это ресторан?", "en": "Boris, is this a restaurant?" },
    { "s": "b", "ru": "Ресторан. Очень новый.", "en": "A restaurant. A very new one." },
    { "s": "a", "ru": "Что тут есть?", "en": "What do they have?" },
    { "s": "b", "ru": "Есть хлеб, масло, торт.", "en": "There is bread, butter, cake." },
    { "s": "a", "ru": "Торт? Я хочу торт.", "en": "Cake? I want cake." },
    { "s": "b", "ru": "А выпить? Чай?", "en": "And to drink? Tea?" },
    { "s": "a", "ru": "Чай. Только чай.", "en": "Tea. Just tea." },
    { "s": "b", "ru": "Я тоже. И хлеб с маслом.", "en": "Me too. And bread and butter." },
    { "s": "a", "ru": "Обедаешь тут весь год?", "en": "You have lunch here all year?" },
    { "s": "b", "ru": "Весь год. Я это люблю.", "en": "All year. I love it." },
    { "s": "a", "ru": "А торт? Тут есть торт?", "en": "And cake? Do they have cake?" },
    { "s": "b", "ru": "Есть, Катя. Ты его пробуй.", "en": "They do, Katya. Try it." },
    { "s": "c", "ru": "А я? Я тоже хочу торт.", "en": "And me? I want cake too." },
    { "s": "a", "ru": "Аня! И ты тут?", "en": "Anya! You are here as well?" },
    { "s": "c", "ru": "Тут. Торт для всех.", "en": "Here. Cake for everybody." }
   ],
   "questions": [
    { "ask": "Where are they?",
      "options": ["In a new restaurant", "At Boris's flat", "In a shop", "At work"], "answer": 0 },
    { "ask": "What does Katya want?",
      "options": ["Cake and tea", "Bread and butter", "Only tea", "Nothing"], "answer": 0 },
    { "ask": "What is Boris having?",
      "options": ["Tea, bread and butter", "Only cake", "Only tea", "Nothing yet"], "answer": 0 },
    { "ask": "How often does Boris eat there?",
      "options": ["All year round", "It is his first time", "Once a month", "Only in the evening"],
      "answer": 0 },
    { "ask": "Who joins them at the end?",
      "options": ["Anya, who also wants cake", "Nobody", "The waiter", "Boris's brother"], "answer": 0 }
   ]
  },

