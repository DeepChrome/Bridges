{
 "chapter": 2,
 "name": "Time, Life & People",
 "lessons": {
  "core2:0": {
   "title": "A man sent by Ivan",
   "cast": [
    { "id": "a", "ru": "Аня", "en": "Anya" },
    { "id": "b", "ru": "Борис", "en": "Boris" },
    { "id": "c", "ru": "Иван", "en": "Ivan" }
   ],
   "lines": [
    { "s": "a", "ru": "Борис, кто этот человек?", "en": "Boris, who is that man?" },
    { "s": "b", "ru": "Этот? Он от Ивана.", "en": "That one? He is from Ivan." },
    { "s": "a", "ru": "От Ивана? Для нас?", "en": "From Ivan? For us?" },
    { "s": "b", "ru": "Да, Аня, для нас.", "en": "Yes, Anya, for us." },
    { "s": "a", "ru": "А ты знаешь его?", "en": "And do you know him?" },
    { "s": "b", "ru": "Не очень. Я о нём знаю.", "en": "Not very well. I know of him." },
    { "s": "b", "ru": "Иван о нём говорит.", "en": "Ivan talks about him." },
    { "s": "a", "ru": "И что он говорит?", "en": "And what does he say?" },
    { "s": "b", "ru": "Что этот человек свой.", "en": "That this man is one of ours." },
    { "s": "a", "ru": "Свой? А я его не знаю.", "en": "One of ours? But I do not know him." },
    { "s": "b", "ru": "Все его знают.", "en": "Everybody knows him." },
    { "s": "a", "ru": "Все? Как так?", "en": "Everybody? How is that?" },
    { "s": "b", "ru": "Он тут уже год.", "en": "He has been here a year." },
    { "s": "c", "ru": "Я говорю о нём. Он свой.", "en": "I am the one who talks about him. He is one of ours." },
    { "s": "b", "ru": "Иван! И ты тут?", "en": "Ivan! You are here too?" },
    { "s": "c", "ru": "Тут. Человек от меня.", "en": "Here. The man comes from me." }
   ],
   "questions": [
    { "ask": "Who sent the man?", "options": ["Ivan", "Boris", "Anya", "Nobody sent him"], "answer": 0 },
    { "ask": "Who has he come for?", "options": ["The two of them", "Ivan", "Anya only", "He is lost"], "answer": 0 },
    { "ask": "How well does Boris know him?",
      "options": ["Not well, only by reputation", "Very well", "They are brothers", "Not at all"], "answer": 0 },
    { "ask": "What does Ivan say about him, once he turns up?",
      "options": ["He is one of ours", "He is an outsider", "He talks too much", "Nothing at all"], "answer": 0 },
    { "ask": "How long has the man been there?",
      "options": ["A year", "A week", "He has just arrived", "Nobody says"], "answer": 0 }
   ]
  },

  "core2:1": {
   "title": "All her time",
   "cast": [
    { "id": "a", "ru": "Маша", "en": "Masha" },
    { "id": "b", "ru": "Виктор", "en": "Viktor" }
   ],
   "lines": [
    { "s": "b", "ru": "Маша, чей это ребёнок?", "en": "Masha, whose child is this?" },
    { "s": "a", "ru": "Это мой ребёнок.", "en": "He is my child." },
    { "s": "b", "ru": "Он тут один?", "en": "Is he here on his own?" },
    { "s": "a", "ru": "Нет, не один. Я здесь.", "en": "No, not alone. I am here." },
    { "s": "b", "ru": "Сколько у тебя времени?", "en": "How much time do you have?" },
    { "s": "a", "ru": "Всё моё время — он.", "en": "All my time is him." },
    { "s": "b", "ru": "Всё время?", "en": "The whole time?" },
    { "s": "a", "ru": "Да, всё время.", "en": "Yes, the whole time." },
    { "s": "b", "ru": "А ты одна?", "en": "And you are on your own?" },
    { "s": "a", "ru": "Одна. Все там.", "en": "On my own. Everyone else is over there." },
    { "s": "b", "ru": "Все? А я здесь, Маша.", "en": "Everyone? Well, I am here, Masha." },
    { "s": "a", "ru": "Ты здесь, Виктор. Это очень...", "en": "You are here, Viktor. That is really..." },
    { "s": "b", "ru": "Я могу быть тут.", "en": "I can stay here." },
    { "s": "a", "ru": "Ты, я и мой ребёнок.", "en": "You, me and my child." }
   ],
   "questions": [
    { "ask": "Whose child is it?", "options": ["Masha's", "Viktor's", "Anya's", "Nobody knows"], "answer": 0 },
    { "ask": "Is the child there alone?",
      "options": ["No, his mother is with him", "Yes", "He is with Viktor", "He is at home"], "answer": 0 },
    { "ask": "How much of her time does he take?",
      "options": ["All of it", "An hour a day", "None", "Only the evenings"], "answer": 0 },
    { "ask": "Where is everyone else?",
      "options": ["Somewhere else", "Right there", "With the child", "At Viktor's"], "answer": 0 },
    { "ask": "What does Viktor offer to do?",
      "options": ["Stay there with her", "Take the child", "Come back later", "Nothing"], "answer": 0 }
   ]
  },

  "core2:2": {
   "title": "Who still works",
   "cast": [
    { "id": "a", "ru": "Катя", "en": "Katya" },
    { "id": "b", "ru": "Олег", "en": "Oleg" }
   ],
   "lines": [
    { "s": "a", "ru": "Олег, ты работаешь?", "en": "Oleg, are you working?" },
    { "s": "b", "ru": "Работаю. А ты, Катя?", "en": "I am. And you, Katya?" },
    { "s": "a", "ru": "Я? Уже нет.", "en": "Me? Not any more." },
    { "s": "b", "ru": "Уже нет? Как так?", "en": "Not any more? How come?" },
    { "s": "a", "ru": "Так. У меня есть ребёнок.", "en": "That is how it is. I have a child." },
    { "s": "b", "ru": "Ребёнок! Один?", "en": "A child! Just one?" },
    { "s": "a", "ru": "Один. Ему год.", "en": "One. He is a year old." },
    { "s": "b", "ru": "Год? И ты не работаешь?", "en": "A year? And you are not working?" },
    { "s": "a", "ru": "Не работаю. Всё время он.", "en": "I am not. He takes all my time." },
    { "s": "b", "ru": "Я работаю. Все работают.", "en": "I work. Everyone works." },
    { "s": "a", "ru": "Все? И Иван?", "en": "Everyone? Ivan too?" },
    { "s": "b", "ru": "Иван? Он не может работать.", "en": "Ivan? He cannot work." },
    { "s": "a", "ru": "А Иван тут уже?", "en": "And is Ivan here already?" },
    { "s": "b", "ru": "Иван тут до нас.", "en": "Ivan was here before us." },
    { "s": "a", "ru": "До нас? Уже так?", "en": "Before us? Already?" },
    { "s": "b", "ru": "Так. Он всё знает.", "en": "That is right. He knows everything." }
   ],
   "questions": [
    { "ask": "Does Katya work?",
      "options": ["Not any more", "Yes, all day", "Only mornings", "She never has"], "answer": 0 },
    { "ask": "Why not?",
      "options": ["She has a child", "She is ill", "There is no work", "She is studying"], "answer": 0 },
    { "ask": "How old is the child?",
      "options": ["A year", "A month", "Three", "She does not say"], "answer": 0 },
    { "ask": "What does Oleg say about Ivan?",
      "options": ["He has been there longer than them", "He works too much", "He is Katya's brother", "He has left"],
      "answer": 0 },
    { "ask": "Which of them is still working?",
      "options": ["Oleg", "Katya", "Neither", "Both"], "answer": 0 }
   ]
  },

  "core2:3": {
   "title": "What she does all day",
   "cast": [
    { "id": "a", "ru": "Пётр", "en": "Pyotr" },
    { "id": "b", "ru": "Юра", "en": "Yura" }
   ],
   "lines": [
    { "s": "b", "ru": "Пётр, что вы делаете?", "en": "Pyotr, what do you do?" },
    { "s": "a", "ru": "Я делаю то, что могу.", "en": "I do what I can." },
    { "s": "b", "ru": "А что вы можете?", "en": "And what can you do?" },
    { "s": "a", "ru": "Всё. Я всё могу сделать.", "en": "Everything. I can do anything." },
    { "s": "b", "ru": "Такой человек! Весь день?", "en": "What a person! All day?" },
    { "s": "a", "ru": "Весь день. Я это люблю.", "en": "All day. I love it." },
    { "s": "b", "ru": "А ваш ребёнок? Он с вами?", "en": "And your child? Is he with you?" },
    { "s": "a", "ru": "Мой ребёнок? Он здесь.", "en": "My child? He is here." },
    { "s": "b", "ru": "Весь день здесь?", "en": "Here all day?" },
    { "s": "a", "ru": "Весь день. Я его люблю.", "en": "All day. I love him." },
    { "s": "b", "ru": "Вы всё делаете для него.", "en": "You do it all for him." },
    { "s": "a", "ru": "Для него. И для вас.", "en": "For him. And for you." },
    { "s": "b", "ru": "Для нас? Так не может быть.", "en": "For us? That cannot be." },
    { "s": "a", "ru": "Может, Юра. Я это делаю.", "en": "It can, Yura. I am doing it." }
   ],
   "questions": [
    { "ask": "What does Pyotr say he can do?",
      "options": ["Anything", "Very little", "Only his own work", "He does not answer"], "answer": 0 },
    { "ask": "How long is his day?",
      "options": ["All day", "An hour", "Half a day", "He does not say"], "answer": 0 },
    { "ask": "Who is with him all day?",
      "options": ["His child", "Yura", "Nobody", "His wife"], "answer": 0 },
    { "ask": "Who does he say he does it for?",
      "options": ["His child, and for Yura too", "Himself", "Ivan", "Nobody at all"], "answer": 0 },
    { "ask": "How does Yura take that?",
      "options": ["He can hardly believe it", "He is annoyed", "He walks away", "He says nothing"], "answer": 0 }
   ]
  },

  "core2:4": {
   "title": "The new job",
   "cast": [
    { "id": "a", "ru": "Соня", "en": "Sonya" },
    { "id": "b", "ru": "Миша", "en": "Misha" }
   ],
   "lines": [
    { "s": "b", "ru": "Соня, у тебя новая работа?", "en": "Sonya, have you got a new job?" },
    { "s": "a", "ru": "Новая. Я уже иду.", "en": "A new one. I am on my way there." },
    { "s": "b", "ru": "Идёшь? Уже?", "en": "Going? Already?" },
    { "s": "a", "ru": "Только на день.", "en": "Only for the day." },
    { "s": "b", "ru": "Только на день? И всё?", "en": "Only for a day? That is all?" },
    { "s": "a", "ru": "И всё, Миша. Не знаю.", "en": "That is all, Misha. I do not know." },
    { "s": "b", "ru": "А работа? Какая?", "en": "And the work? What sort?" },
    { "s": "a", "ru": "Не для себя. Для всех.", "en": "Not for myself. For everyone." },
    { "s": "b", "ru": "Для всех? Как это?", "en": "For everyone? How do you mean?" },
    { "s": "a", "ru": "Так. Я это могу.", "en": "Just so. I can do it." },
    { "s": "b", "ru": "А ты идёшь одна?", "en": "And are you going alone?" },
    { "s": "a", "ru": "Одна. Только я.", "en": "Alone. Just me." },
    { "s": "b", "ru": "Ещё не время, Соня.", "en": "It is not time yet, Sonya." },
    { "s": "a", "ru": "Уже время. Я иду.", "en": "It is time. I am going." }
   ],
   "questions": [
    { "ask": "What has Sonya got?",
      "options": ["A new job", "A new flat", "A day off", "A new child"], "answer": 0 },
    { "ask": "How long is it for?",
      "options": ["One day", "A year", "A month", "For good"], "answer": 0 },
    { "ask": "Who does she say the work is for?",
      "options": ["Everyone", "Herself", "Misha", "Her family"], "answer": 0 },
    { "ask": "Is anyone going with her?",
      "options": ["No, she goes alone", "Misha", "Her child", "Ivan"], "answer": 0 },
    { "ask": "How does the conversation end?",
      "options": ["She leaves straight away", "She waits", "She changes her mind", "Misha goes instead"],
      "answer": 0 }
   ]
  },

  "food:0": {
