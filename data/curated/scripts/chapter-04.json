    { "s": "a", "ru": "Новая. И на площади.", "en": "New. And on the square." },
    { "s": "b", "ru": "Площадь, музей, парк.", "en": "The square, the museum, the park." },
    { "s": "a", "ru": "И мой офис у аэропорта.", "en": "And my office by the airport." }
   ],
   "questions": [
