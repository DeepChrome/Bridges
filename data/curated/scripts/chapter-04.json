  "core4:0": {
   "title": "A question about the car",
   "cast": [
    { "id": "a", "ru": "Маша", "en": "Masha" },
    { "id": "b", "ru": "Иван", "en": "Ivan" },
    { "id": "c", "ru": "Олег", "en": "Oleg" }
   ],
   "lines": [
    { "s": "b", "ru": "Маша, у меня вопрос.", "en": "Masha, I have a question." },
    { "s": "a", "ru": "Вопрос? Какой, Иван?", "en": "A question? What is it, Ivan?" },
    { "s": "b", "ru": "Твоя машина тут?", "en": "Is your car here?" },
    { "s": "a", "ru": "Машина? Она всегда тут.", "en": "The car? It is always here." },
    { "s": "b", "ru": "А кто придёт сегодня?", "en": "And who is coming today?" },
    { "s": "a", "ru": "Придёт Олег. Как всегда.", "en": "Oleg is coming. As always." },
    { "s": "b", "ru": "Олег же не в России?", "en": "But Oleg is not in Russia, is he?" },
    { "s": "a", "ru": "В России. Он тут уже год.", "en": "He is in Russia. He has been here a year." },
    { "s": "b", "ru": "Год! А у меня вопрос.", "en": "A year! And I have a question." },
    { "s": "a", "ru": "Ещё вопрос? Какой?", "en": "Another question? What?" },
    { "s": "b", "ru": "Машина. Она для всех?", "en": "The car. Is it for everybody?" },
    { "s": "a", "ru": "Для всех, кто придёт.", "en": "For everybody who comes." },
    { "s": "c", "ru": "Я уже тут. Я Олег.", "en": "I am here already. I am Oleg." },
    { "s": "b", "ru": "Олег! А машина?", "en": "Oleg! And the car?" },
    { "s": "c", "ru": "Машина не моя. Она Маши.", "en": "The car is not mine. It is Masha's." }
   ],
   "questions": [
    { "ask": "What does Ivan want to know about?",
      "options": ["Masha's car", "Oleg's job", "Where Masha lives", "The time"], "answer": 0 },
    { "ask": "How often is the car there?",
      "options": ["Every day", "Once a week", "Only today", "Never"], "answer": 0 },
    { "ask": "Who is coming today?",
      "options": ["Oleg", "Ivan's brother", "Nobody", "Masha's father"], "answer": 0 },
    { "ask": "What surprises Ivan about Oleg?",
      "options": ["That he is in Russia", "That he has a car", "That he is late", "That he is a friend"],
      "answer": 0 },
    { "ask": "Who does Oleg say the car belongs to?",
      "options": ["Masha", "Himself", "Ivan", "Nobody in particular"], "answer": 0 }
   ]
  },

  "core4:1": {
   "title": "The book in her hand",
   "cast": [
    { "id": "a", "ru": "Катя", "en": "Katya" },
    { "id": "b", "ru": "Соня", "en": "Sonya" }
   ],
   "lines": [
    { "s": "b", "ru": "Катя, можно вопрос?", "en": "Katya, may I ask something?" },
    { "s": "a", "ru": "Можно. Почему нет?", "en": "You may. Why not?" },
    { "s": "b", "ru": "Что там, в твоей руке?", "en": "What is that in your hand?" },
    { "s": "a", "ru": "В руке? Книга.", "en": "In my hand? A book." },
    { "s": "b", "ru": "Книга? Можно её читать?", "en": "A book? May I read it?" },
    { "s": "a", "ru": "Читать можно. Но не сейчас.", "en": "You may read it. But not now." },
    { "s": "b", "ru": "Почему не сейчас?", "en": "Why not now?" },
    { "s": "a", "ru": "Через час. Я её читаю.", "en": "In an hour. I am reading it." },
    { "s": "b", "ru": "Через час? А я хочу сейчас.", "en": "In an hour? But I want it now." },
    { "s": "a", "ru": "Сейчас она в моих руках.", "en": "Right now it is in my hands." },
    { "s": "b", "ru": "В твоих руках всегда книга.", "en": "There is always a book in your hands." },
    { "s": "a", "ru": "Всегда, Соня. Я люблю читать.", "en": "Always, Sonya. I love reading." },
    { "s": "b", "ru": "А почему там, а не тут?", "en": "And why over there, not here?" },
    { "s": "a", "ru": "Там я всегда читаю.", "en": "That is where I always read." }
   ],
   "questions": [
    { "ask": "What is in Katya's hand?",
      "options": ["A book", "A key", "Money", "Nothing"], "answer": 0 },
    { "ask": "May Sonya read it?",
      "options": ["Not for another hour", "Yes, at once", "Never", "Only if she asks again"], "answer": 0 },
    { "ask": "Why not now?",
      "options": ["She is reading it herself", "It is not hers to lend out", "It is written in Russian", "She will not give a reason"],
      "answer": 0 },
    { "ask": "What does Sonya say about her?",
      "options": ["She always has a book", "She never reads", "She reads too slowly", "She should sit down"],
      "answer": 0 },
    { "ask": "Why does she sit over there?",
      "options": ["It is where she always reads", "It is quieter than in here", "There is more light over there", "Sonya is sitting in here"],
      "answer": 0 }
   ]
  },

  "core4:2": {
   "title": "No money for the film",
   "cast": [
    { "id": "a", "ru": "Лена", "en": "Lena" },
    { "id": "b", "ru": "Миша", "en": "Misha" }
   ],
   "lines": [
    { "s": "b", "ru": "Лена, есть проблема.", "en": "Lena, there is a problem." },
    { "s": "a", "ru": "Проблема? Какая?", "en": "A problem? What is it?" },
    { "s": "b", "ru": "Деньги. У меня их нет.", "en": "Money. I have none." },
    { "s": "a", "ru": "Нет денег? Это проблема.", "en": "No money? That is a problem." },
    { "s": "b", "ru": "Проблема. А я хочу на фильм.", "en": "It is. And I want to go to a film." },
    { "s": "a", "ru": "На фильм? Есть места?", "en": "To a film? Are there seats?" },
    { "s": "b", "ru": "Места есть. Денег нет.", "en": "There are seats. There is no money." },
    { "s": "a", "ru": "А школа? Ты там работаешь?", "en": "And the school? Do you work there?" },
    { "s": "b", "ru": "Работаю. Но это школа.", "en": "I do. But it is a school." },
    { "s": "a", "ru": "Хорошо. Деньги у меня.", "en": "All right. I have money." },
    { "s": "b", "ru": "У тебя? Ты же врач.", "en": "You do? Well, you are a doctor." },
    { "s": "a", "ru": "Врач. И у врача есть деньги.", "en": "A doctor. And a doctor has money." },
    { "s": "b", "ru": "Так мы идём на фильм?", "en": "So we are going to the film?" },
    { "s": "a", "ru": "Идём, Миша. Место есть.", "en": "We are, Misha. There is room." }
   ],
   "questions": [
    { "ask": "What is Misha's problem?",
      "options": ["He has no money", "There are no seats", "He has no time", "He is ill"], "answer": 0 },
    { "ask": "Where does he want to go?",
      "options": ["To a film", "To the school", "To the doctor", "Home"], "answer": 0 },
    { "ask": "Where does Misha work?",
      "options": ["At a school", "At a hospital", "Nowhere", "With Lena"], "answer": 0 },
    { "ask": "What does Lena do?",
      "options": ["She is a doctor", "She teaches", "She is a student", "She does not say"], "answer": 0 },
    { "ask": "How is it settled?",
      "options": ["Lena pays and they go", "They stay at home", "Misha borrows from work", "They go tomorrow"],
      "answer": 0 }
   ]
  },

  "core4:3": {
   "title": "The first house on the street",
   "cast": [
    { "id": "a", "ru": "Нина", "en": "Nina" },
    { "id": "b", "ru": "Пётр", "en": "Pyotr" }
   ],
   "lines": [
    { "s": "b", "ru": "Нина, это твой дом?", "en": "Nina, is this your house?" },
    { "s": "a", "ru": "Мой. Который тут первый.", "en": "Mine. The first one here." },
    { "s": "b", "ru": "Первый дом? Он большой.", "en": "The first house? It is big." },
    { "s": "a", "ru": "Большой. И он много стоит.", "en": "Big. And it costs a lot." },
    { "s": "b", "ru": "Много стоит? Сколько?", "en": "Costs a lot? How much?" },
    { "s": "a", "ru": "Не скажу, Пётр. Но много.", "en": "I will not say, Pyotr. But a lot." },
    { "s": "b", "ru": "А кто там живёт?", "en": "And who lives there?" },
    { "s": "a", "ru": "Мой отец. И я.", "en": "My father. And me." },
    { "s": "b", "ru": "А что нужно отцу?", "en": "And what does your father need?" },
    { "s": "a", "ru": "Отцу нужно время.", "en": "My father needs time." },
    { "s": "b", "ru": "Время? А не деньги?", "en": "Time? Not money?" },
    { "s": "a", "ru": "И деньги. Но время нужно.", "en": "Money too. But time is what he needs." },
    { "s": "b", "ru": "А ты, Нина? Ты играешь?", "en": "And you, Nina? Do you play?" },
    { "s": "a", "ru": "Играю. Когда есть время.", "en": "I do. When there is time." }
   ],
   "questions": [
    { "ask": "Which house is hers?",
      "options": ["The first one there", "The big one on the corner", "The one by the bridge", "She does not say"],
      "answer": 0 },
    { "ask": "How much did it cost?",
      "options": ["A lot — she will not say more", "Nothing, it was her father's", "Very little", "She gives the exact sum"],
      "answer": 0 },
    { "ask": "Who lives in it?",
      "options": ["Nina and her father", "Nina, all on her own", "Her whole family too", "Her father, alone"], "answer": 0 },
    { "ask": "What does her father need most?",
      "options": ["Time", "Money", "A new house", "Company"], "answer": 0 },
    { "ask": "When does Nina play?",
      "options": ["When she has the time", "Every day", "Never", "Only with her father"], "answer": 0 }
   ]
  },

  "core4:4": {
   "title": "He never goes",
   "cast": [
    { "id": "a", "ru": "Соня", "en": "Sonya" },
    { "id": "b", "ru": "Виктор", "en": "Viktor" }
   ],
   "lines": [
    { "s": "b", "ru": "Соня, ты пойдёшь?", "en": "Sonya, are you going?" },
    { "s": "a", "ru": "Пойду. А ты, Виктор?", "en": "I am. And you, Viktor?" },
    { "s": "b", "ru": "Я? Я никогда не пойду.", "en": "Me? I will never go." },
    { "s": "a", "ru": "Никогда? Почему?", "en": "Never? Why?" },
    { "s": "b", "ru": "Там место, которое я не люблю.", "en": "It is a place I do not like." },
    { "s": "a", "ru": "Не любишь? А я пойду.", "en": "You do not like it? Well, I am going." },
    { "s": "b", "ru": "Одна? Так не надо.", "en": "On your own? You should not." },
    { "s": "a", "ru": "Надо. Я всегда иду одна.", "en": "I should. I always go on my own." },
    { "s": "b", "ru": "Всегда одна... А сегодня?", "en": "Always alone... And today?" },
    { "s": "a", "ru": "Сегодня тоже. Как всегда.", "en": "Today as well. As always." },
    { "s": "b", "ru": "Так я тоже пойду.", "en": "In that case I will come too." },
    { "s": "a", "ru": "Ты же никогда не идёшь!", "en": "But you never go!" },
    { "s": "b", "ru": "Не иду. Но сегодня пойду.", "en": "I do not. But today I will." },
    { "s": "a", "ru": "Хорошо. Идём.", "en": "All right. Let us go." }
   ],
   "questions": [
    { "ask": "Why will Viktor not go?",
      "options": ["He does not like the place", "He has no money for it now", "He is working that evening", "He was not invited at all"],
      "answer": 0 },
    { "ask": "Does Sonya usually go with anyone?",
      "options": ["No, she always goes alone", "Yes, always with Viktor", "No, she never goes there", "Yes, with her family"],
      "answer": 0 },
    { "ask": "What changes Viktor's mind?",
      "options": ["That she would go alone", "That she asks him along", "That it is happening today", "Nothing changes it at all"],
      "answer": 0 },
    { "ask": "How does Sonya take his change of heart?",
      "options": ["She points out he never goes", "She tells him to stay at home", "She is annoyed with him", "She does not notice it"],
      "answer": 0 },
    { "ask": "How does it end?",
      "options": ["They go together", "She goes alone", "Neither goes", "They argue"], "answer": 0 }
   ]
  },

  "city:0": {
   "title": "Looking for the bank",
   "cast": [
    { "id": "a", "ru": "Аня", "en": "Anya" },    { "id": "b", "ru": "Олег", "en": "Oleg" },
    { "id": "c", "ru": "Нина", "en": "Nina" }
   ],
   "lines": [
    { "s": "a", "ru": "Олег, я ищу банк.", "en": "Oleg, I am looking for a bank." },
    { "s": "b", "ru": "Банк? Аня, он в центре.", "en": "A bank? Anya, it is in the centre." },{ "s": "a", "ru": "А отель? Где мой отель?", "en": "And the hotel? Where is my hotel?" },
    { "s": "b", "ru": "Отель тоже в центре.", "en": "The hotel is in the centre too." },
    { "s": "a", "ru": "А рынок? Он там же?", "en": "And the market? Is that there as well?" },
    { "s": "b", "ru": "Рынок не в центре. Он тут.", "en": "The market is not in the centre. It is here." },
    { "s": "a", "ru": "Тут? А кино?", "en": "Here? And the cinema?" },
    { "s": "b", "ru": "Кино в центре. Все там.", "en": "The cinema is in the centre. Everything is there." },
    { "s": "a", "ru": "Так мне в центр, Олег.", "en": "So it is the centre for me, Oleg." },
    { "s": "b", "ru": "Так. Иди по этой дороге.", "en": "That is right. Go along this road." },
    { "s": "a", "ru": "По дороге — и банк?", "en": "Along the road — and there is the bank?" },    { "s": "b", "ru": "Банк, отель и кино. Всё там.", "en": "Bank, hotel and cinema. All of it is there." },
    { "s": "c", "ru": "Аня, я тоже иду в центр.", "en": "Anya, I am going to the centre too." },
    { "s": "a", "ru": "Нина! Ты знаешь дорогу?", "en": "Nina! Do you know the way?" },
    { "s": "c", "ru": "Знаю. Иди со мной.", "en": "I do. Come with me." }
   ],
   "questions": [
    { "ask": "What is Anya looking for?",
      "options": ["A bank", "The market", "Her hotel first", "A cinema"], "answer": 0 },
    { "ask": "Where is it?",
      "options": ["In the centre", "By the market", "Out of town", "Next to the hotel only"], "answer": 0 },
    { "ask": "Which thing is not in the centre?",
      "options": ["The market", "The bank", "The hotel", "The cinema"], "answer": 0 },
    { "ask": "How does Oleg tell her to get there?",
      "options": ["Along this road", "By taxi", "Ask at the hotel", "Follow him"], "answer": 0 },    { "ask": "Who offers to take her there?",
      "options": ["Nina", "Oleg", "Nobody", "A taxi driver"], "answer": 0 }
   ]
  },

