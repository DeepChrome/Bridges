    { "s": "b", "ru": "В деревне нет вокзала.", "en": "There is no station in the village either." },
    { "s": "a", "ru": "Нет вокзала, нет почты.", "en": "No station, no post office." },
    { "s": "b", "ru": "А церковь? Она есть, Таня?", "en": "And a church? Is there one, Tanya?" }
