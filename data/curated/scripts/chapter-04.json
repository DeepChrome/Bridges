  "city:3": {
   "title": "The office by the bridge",
   "cast": [
    { "id": "a", "ru": "Лена", "en": "Lena" },
    { "id": "b", "ru": "Иван", "en": "Ivan" }
   ],
   "lines": [
    { "s": "b", "ru": "Лена, где твой кабинет?", "en": "Lena, where is your office?" },
    { "s": "a", "ru": "Кабинет? В этом здании.", "en": "My office? In this building." },
    { "s": "b", "ru": "В этом? Большое здание.", "en": "This one? It is a big building." },
    { "s": "a", "ru": "Большое. Тут весь район.", "en": "Big. The whole district is in here." },
    { "s": "b", "ru": "Район? А станция где?", "en": "The district? And where is the station?" },
    { "s": "a", "ru": "Станция за мостом.", "en": "The station is over the bridge." },
    { "s": "b", "ru": "За мостом? А клуб?", "en": "Over the bridge? And the club?" },
    { "s": "a", "ru": "Клуб тоже там. У станции.", "en": "The club is there too. By the station." },
    { "s": "b", "ru": "А почтовый адрес? Какой?", "en": "And the postal address? What is it?" },
    { "s": "a", "ru": "Почтовый адрес — это здание.", "en": "The postal address is this building." },
