  "core5:0": {
   "title": "The biggest one",
   "cast": [
    { "id": "a", "ru": "Аня", "en": "Anya" },
    { "id": "b", "ru": "Миша", "en": "Misha" }
   ],
   "lines": [
    { "s": "b", "ru": "Аня, что ты хочешь купить?", "en": "Anya, what do you want to buy?" },
    { "s": "a", "ru": "Я? Я хочу купить самое большое.", "en": "Me? I want to buy the biggest one." },
    { "s": "b", "ru": "Самое большое? Почему?", "en": "The biggest one? Why?" },
    { "s": "a", "ru": "Так. Мне нужно больше.", "en": "Just because. I need more." },
    { "s": "b", "ru": "Больше? А та женщина?", "en": "More? And what about that woman?" },
    { "s": "a", "ru": "Какая женщина? Та, что стоит?", "en": "Which woman? The one standing there?" },
    { "s": "b", "ru": "Та. Она говорит об этом.", "en": "That one. She is talking about it." },
    { "s": "a", "ru": "Об этом? Что она говорит?", "en": "About it? What is she saying?" },
    { "s": "b", "ru": "То, что это самое большое.", "en": "That this is the biggest one." },
    { "s": "a", "ru": "Самое большое — это то, что я хочу.", "en": "The biggest one is what I want." },
    { "s": "b", "ru": "Так купи, Аня.", "en": "Then buy it, Anya." },
    { "s": "a", "ru": "Куплю. А ты, Миша, стоишь?", "en": "I will. And you, Misha, are you just standing there?" },
    { "s": "b", "ru": "Стою. Я тут стою.", "en": "I am. I am standing right here." },
    { "s": "a", "ru": "Стой. Я больше не хочу.", "en": "Stay there. I do not want any more." }
   ],
   "questions": [
    { "ask": "What does Anya want to buy?",
      "options": ["The biggest one there is", "The cheapest one", "Nothing", "Whatever Misha says"],
      "answer": 0 },
    { "ask": "Who else is talking about it?",
      "options": ["A woman standing nearby", "Misha's mother", "Nobody", "The shopkeeper"], "answer": 0 },
    { "ask": "What does the woman say?",
      "options": ["That it is the biggest", "That it is too expensive", "Nothing useful", "That it is sold"],
      "answer": 0 },
    { "ask": "What does Misha tell her to do?",
      "options": ["Buy it", "Leave it", "Ask the woman", "Think about it"], "answer": 0 },
    { "ask": "What is Misha doing while she decides?",
      "options": ["Standing there", "Walking away", "Buying something himself", "Waiting outside"],
      "answer": 0 }
   ]
  },

  "core5:1": {
   "title": "Waiting at the door",
   "cast": [
    { "id": "a", "ru": "Катя", "en": "Katya" },    { "id": "b", "ru": "Борис", "en": "Boris" },
    { "id": "c", "ru": "Нина", "en": "Nina" }
   ],
   "lines": [
    { "s": "b", "ru": "Катя, сколько ты ждёшь?", "en": "Katya, how long have you been waiting?" },
    { "s": "a", "ru": "Жду уже час. Перед дверью.", "en": "An hour already. In front of the door." },
    { "s": "b", "ru": "Перед дверью? А кто там?", "en": "In front of the door? Who is in there?" },
    { "s": "a", "ru": "Там женщина. Она мне даст книгу.", "en": "There is a woman. She is going to give me a book." },
    { "s": "b", "ru": "Даст книгу? Какую книгу?", "en": "Give you a book? Which book?" },
    { "s": "a", "ru": "Последнюю. Она самая новая.", "en": "The last one. It is the newest." },
    { "s": "b", "ru": "А это Москва? Тут все ждут.", "en": "Well, this is Moscow. Everybody waits here." },
    { "s": "a", "ru": "Москва. Тут всегда ждут.", "en": "Moscow. People always wait here." },
    { "s": "b", "ru": "Сколько ещё ждать?", "en": "How much longer do you have to wait?" },
    { "s": "a", "ru": "Не знаю, Борис. Может, час.", "en": "I do not know, Boris. Maybe an hour." },
    { "s": "b", "ru": "Час! А дверь всё стоит.", "en": "An hour! And the door has not moved." },    { "s": "a", "ru": "Дверь стоит. И я стою.", "en": "The door stands. And so do I." },
    { "s": "c", "ru": "Катя? Вот книга.", "en": "Katya? Here is the book." },
    { "s": "a", "ru": "Нина! Книга?", "en": "Nina! The book?" },
    { "s": "c", "ru": "Книга. Самая новая.", "en": "The book. The newest one." }
   ],
   "questions": [
    { "ask": "How long has Katya been waiting?",
      "options": ["An hour", "A minute", "All day", "She has just arrived"], "answer": 0 },
    { "ask": "Where is she?",
      "options": ["In front of a door", "At home", "In a shop", "On a train"], "answer": 0 },
    { "ask": "What is she waiting for?",
      "options": ["A book from a woman", "A friend", "A door to be fixed", "A bus"], "answer": 0 },
    { "ask": "What does Boris say about Moscow?",
      "options": ["Everybody waits there", "Nobody waits there", "It is too big", "He has never been"],
      "answer": 0 },    { "ask": "How does the wait end?",
      "options": ["Nina comes out with the book", "She gives up", "She waits another hour", "The door stays shut"],
      "answer": 0 }
   ]
  },

  "core5:2": {
   "title": "The whole family at home",
   "cast": [
    { "id": "a", "ru": "Борис", "en": "Boris" },
    { "id": "b", "ru": "Олег", "en": "Oleg" }
   ],
   "lines": [
    { "s": "b", "ru": "Борис, ты дома?", "en": "Boris, are you at home?" },
    { "s": "a", "ru": "Дома. Вся семья дома.", "en": "At home. The whole family is at home." },
    { "s": "b", "ru": "Вся семья? А где находится ваш дом?", "en": "The whole family? And where is your house?" },
    { "s": "a", "ru": "Наш дом находится у воды.", "en": "Our house is by the water." },
    { "s": "b", "ru": "У воды! Это хорошо.", "en": "By the water! That is good." },
    { "s": "a", "ru": "Хорошо. Но мы хотим выйти.", "en": "It is. But we want to go out." },
    { "s": "b", "ru": "Выйти? Все?", "en": "Go out? All of you?" },
    { "s": "a", "ru": "Все. И та девушка тоже.", "en": "All of us. And that girl as well." },
    { "s": "b", "ru": "Какая девушка? Я её знаю?", "en": "Which girl? Do I know her?" },
    { "s": "a", "ru": "Знаешь ли ты её? Не думаю.", "en": "Do you know her? I do not think so." },
    { "s": "b", "ru": "Не знаю. Но я выйду с вами.", "en": "I do not. But I will come out with you." },
    { "s": "a", "ru": "Выйди, Олег. Мы дома ждём.", "en": "Come out, Oleg. We are waiting at home." }
   ],
   "questions": [
    { "ask": "Where is Boris?",
      "options": ["At home with his family", "At a friend's", "By the river alone", "At work"], "answer": 0 },
    { "ask": "Where is the house?",
      "options": ["By the water", "In the centre", "By the station", "He does not say"], "answer": 0 },
    { "ask": "What does the family want to do?",
      "options": ["Go out", "Stay in", "Move house", "Wait for Oleg to leave"], "answer": 0 },
    { "ask": "Who else is with them?",
      "options": ["A girl Oleg does not know", "Oleg's sister", "Nobody", "Two children"], "answer": 0 },
    { "ask": "What does Oleg decide?",
      "options": ["To join them", "To stay away", "To meet them later", "To ask who the girl is first"],
      "answer": 0 }
   ]
  },

  "core5:3": {
   "title": "He needs Russian for the job",
   "cast": [
    { "id": "a", "ru": "Нина", "en": "Nina" },
    { "id": "b", "ru": "Юра", "en": "Yura" }
   ],
   "lines": [
    { "s": "b", "ru": "Нина, ты знаешь русский язык?", "en": "Nina, do you know Russian?" },
    { "s": "a", "ru": "Русский? Знаю. Это мой язык.", "en": "Russian? I do. It is my language." },
    { "s": "b", "ru": "Твой? А твоя мама?", "en": "Yours? And your mother?" },
    { "s": "a", "ru": "Мама тоже. Она русская.", "en": "My mother too. She is Russian." },
    { "s": "b", "ru": "Русская! А я только читаю.", "en": "Russian! And I can only read it." },
    { "s": "a", "ru": "Читай. Русский язык — это время.", "en": "Keep reading. Russian takes time." },
    { "s": "b", "ru": "Время... Я хочу получить работу.", "en": "Time... I want to get a job." },
    { "s": "a", "ru": "Работу? В какой компании?", "en": "A job? At which company?" },
    { "s": "b", "ru": "В данной компании. Тут.", "en": "At this very company. Here." },
    { "s": "a", "ru": "В данной? Пожалуйста, Юра, скажи всё.", "en": "This one? Please, Yura, tell me everything." },
    { "s": "b", "ru": "Скажу, Нина. Но нужно знать русский.", "en": "I will, Nina. But you have to know Russian." },
    { "s": "a", "ru": "Нужно. Мама может говорить с тобой.", "en": "You do. My mother could speak with you." }
   ],
   "questions": [
    { "ask": "Whose first language is Russian?",
      "options": ["Nina's", "Yura's", "Neither of theirs", "Only her mother's"], "answer": 0 },
    { "ask": "What does Yura want?",
      "options": ["A job at that company", "To move to Russia", "To teach Russian", "Nothing in particular"],
      "answer": 0 },
    { "ask": "What is standing in his way?",
      "options": ["His Russian", "His age", "Money", "Nina's mother"], "answer": 0 },
    { "ask": "What does Nina ask him to do?",
      "options": ["Tell her everything", "Come back later", "Learn on his own", "Speak to the company"],
      "answer": 0 },
    { "ask": "How does she offer to help?",
      "options": ["Her mother could teach him", "She will speak for him", "She will not help", "She offers him a job"],
      "answer": 0 }
   ]
  },

  "core5:4": {
   "title": "One more minute",
   "cast": [
    { "id": "a", "ru": "Соня", "en": "Sonya" },
    { "id": "b", "ru": "Виктор", "en": "Viktor" }
   ],
   "lines": [
    { "s": "b", "ru": "Соня, ты найдёшь его?", "en": "Sonya, will you find it?" },
    { "s": "a", "ru": "Найду. Дай мне минуту.", "en": "I will. Give me a minute." },
    { "s": "b", "ru": "Минуту? А где он?", "en": "A minute? And where is it?" },
    { "s": "a", "ru": "Не знаю. Но я найду.", "en": "I do not know. But I will find it." },
    { "s": "b", "ru": "Сколько минут, Соня?", "en": "How many minutes, Sonya?" },
    { "s": "a", "ru": "Одну минуту, Виктор.", "en": "One minute, Viktor." },
    { "s": "b", "ru": "Одна минута? Это всё?", "en": "One minute? Is that all?" },
    { "s": "a", "ru": "Всё. Я его найду.", "en": "That is all. I will find it." },
    { "s": "b", "ru": "Найдёшь? Я уже не жду.", "en": "Will you? I am not waiting any more." },
    { "s": "a", "ru": "Жди. Ещё минута.", "en": "Wait. One more minute." },
    { "s": "b", "ru": "Ещё минута! Это уже час.", "en": "Another minute! That is an hour by now." },
    { "s": "a", "ru": "Час? Нет. Минута — и я найду.", "en": "An hour? No. A minute, and I will have it." }
   ],
   "questions": [
    { "ask": "What is Sonya doing?",
      "options": ["Looking for something", "Waiting for Viktor", "Counting the minutes", "Leaving"],
      "answer": 0 },
    { "ask": "Does she know where it is?",
      "options": ["No", "Yes", "Viktor knows", "It is in her hand"], "answer": 0 },
    { "ask": "How long does she keep asking for?",
      "options": ["One more minute", "An hour", "All day", "She does not say"], "answer": 0 },
    { "ask": "How patient is Viktor?",
      "options": ["He says he will not wait any longer", "He is very patient", "He goes to help", "He does not mind"],
      "answer": 0 },
    { "ask": "How does it end?",
      "options": ["She insists she will find it", "She gives up", "He finds it", "They leave without it"],
      "answer": 0 }
   ]
  },

  "body:0": {
   "title": "A healthy man, a sore leg",
   "cast": [
    { "id": "a", "ru": "Аня", "en": "Anya" },
    { "id": "b", "ru": "Пётр", "en": "Pyotr" }
   ],
   "lines": [
    { "s": "a", "ru": "Пётр, что с тобой?", "en": "Pyotr, what is the matter?" },
    { "s": "b", "ru": "Нога болит. Уже день.", "en": "My leg hurts. For a day now." },
    { "s": "a", "ru": "День! Ты больной?", "en": "A day! Are you ill?" },
    { "s": "b", "ru": "Не больной. Я здоровый.", "en": "Not ill. I am healthy." },
    { "s": "a", "ru": "Здоровый, но нога болит?", "en": "Healthy, but your leg hurts?" },
    { "s": "b", "ru": "Болит. Я так чувствую.", "en": "It hurts. That is how it feels." },
    { "s": "a", "ru": "Чувствуешь? А здоровье?", "en": "It feels like that? And your health?" },
    { "s": "b", "ru": "Здоровье есть. Всё есть.", "en": "My health is fine. Everything is fine." },
    { "s": "a", "ru": "А кожа? С кожей всё?", "en": "And your skin? Is your skin all right?" },
    { "s": "b", "ru": "С кожей всё, Аня.", "en": "My skin is fine, Anya." },
    { "s": "a", "ru": "Так что болит, Пётр?", "en": "So what does hurt, Pyotr?" },
    { "s": "b", "ru": "Только нога. И только сегодня.", "en": "Only the leg. And only today." }
   ],
   "questions": [
    { "ask": "What is wrong with Pyotr?",
      "options": ["His leg hurts", "He has a bad cold", "His skin is sore", "Nothing at all"], "answer": 0 },
    { "ask": "How long has it been like that?",
      "options": ["A day", "A week", "Since this morning only", "He does not say"], "answer": 0 },
    { "ask": "Does he think of himself as ill?",
      "options": ["No, he says he is healthy", "Yes, very", "He is not sure", "He says Anya is ill"],
      "answer": 0 },
    { "ask": "What else does Anya ask about?",
      "options": ["His skin", "His teeth", "His work", "His family"], "answer": 0 },
    { "ask": "What is his last word on it?",
      "options": ["Only the leg, only today", "Everything hurts", "He needs a doctor", "It is getting worse"],
      "answer": 0 }
   ]
  },

  "body:1": {
   "title": "No sleep with that shoulder",
   "cast": [
    { "id": "a", "ru": "Маша", "en": "Masha" },
    { "id": "b", "ru": "Катя", "en": "Katya" }
   ],
   "lines": [
    { "s": "b", "ru": "Маша, у тебя болит зуб?", "en": "Masha, is it your tooth that hurts?" },
    { "s": "a", "ru": "Зуб? Нет, плечо.", "en": "A tooth? No, my shoulder." },
    { "s": "b", "ru": "Плечо! А боль большая?", "en": "Your shoulder! Is the pain bad?" },
    { "s": "a", "ru": "Большая. И колено тоже.", "en": "Bad. And my knee as well." },
    { "s": "b", "ru": "Колено и плечо? Это много.", "en": "Knee and shoulder? That is a lot." },
    { "s": "a", "ru": "Много. У меня нет сна.", "en": "It is. I am getting no sleep." },
    { "s": "b", "ru": "Нет сна? А кровь?", "en": "No sleep? And any blood?" },
    { "s": "a", "ru": "Кровь? Нет, крови нет.", "en": "Blood? No, there is no blood." },
    { "s": "b", "ru": "Хорошо. А волосы?", "en": "Good. And your hair?" },
    { "s": "a", "ru": "Волосы? Катя, это не боль!", "en": "My hair? Katya, that is not a pain!" },
    { "s": "b", "ru": "Не боль. Это я так.", "en": "No, it is not. I was only asking." },
    { "s": "a", "ru": "Так... Боль есть. Сна нет.", "en": "Well... there is pain. There is no sleep." }
   ],
   "questions": [
    { "ask": "What hurts?",
      "options": ["Her shoulder and knee", "Her tooth", "Her hair", "Her back"], "answer": 0 },
    { "ask": "How is she sleeping?",
      "options": ["She is not", "Very well", "Only in the day", "She does not say"], "answer": 0 },
    { "ask": "Is there any blood?",
      "options": ["No", "Yes", "She will not look", "Katya does not ask"], "answer": 0 },
    { "ask": "Why does she snap at Katya?",
      "options": ["She asks about her hair", "She does not believe her", "She will not fetch a doctor", "She is late"],
      "answer": 0 },
    { "ask": "Who is doing the asking?",
      "options": ["Katya", "Masha", "Both equally", "A doctor"], "answer": 0 }
   ]
  },

  "body:2": {
   "title": "The whole body aches",
   "cast": [
    { "id": "a", "ru": "Катя", "en": "Katya" },
    { "id": "b", "ru": "Миша", "en": "Misha" }
   ],
   "lines": [
    { "s": "a", "ru": "Миша, где болит?", "en": "Misha, where does it hurt?" },
    { "s": "b", "ru": "Спина. И живот.", "en": "My back. And my stomach." },
    { "s": "a", "ru": "Спина и живот? А грудь?", "en": "Back and stomach? And your chest?" },
    { "s": "b", "ru": "Грудь не болит. Только спина.", "en": "My chest is fine. Only the back." },
    { "s": "a", "ru": "А головная боль? Есть?", "en": "And a headache? Have you got one?" },
    { "s": "b", "ru": "Головной боли нет.", "en": "No headache." },
    { "s": "a", "ru": "Хорошо. А рот? Зуб болит?", "en": "Good. And your mouth? A bad tooth?" },
    { "s": "b", "ru": "Зуб не болит. Тело болит.", "en": "No bad tooth. My body aches." },
    { "s": "a", "ru": "Всё тело? Это много.", "en": "The whole body? That is a lot." },
    { "s": "b", "ru": "Много, Катя. Кто это лечит?", "en": "It is, Katya. Who treats that?" },
    { "s": "a", "ru": "Лечить может врач.", "en": "A doctor can treat it." },
    { "s": "b", "ru": "Врач... Я к нему пойду.", "en": "A doctor... I will go to one." }
   ],
   "questions": [
    { "ask": "What hurts Misha?",
      "options": ["His back and stomach", "His chest", "His head", "A tooth"], "answer": 0 },
    { "ask": "Has he a headache?",
      "options": ["No", "Yes", "Only in the morning", "He is not sure"], "answer": 0 },
    { "ask": "How does he describe it in the end?",
      "options": ["His whole body aches", "Only his back", "It is passing", "It is nothing"], "answer": 0 },
    { "ask": "What does Katya suggest?",
      "options": ["A doctor", "Rest", "Medicine she has", "Waiting a day"], "answer": 0 },
    { "ask": "What will he do?",
      "options": ["Go to the doctor", "Wait and see", "Ignore it", "Ask Katya to come"], "answer": 0 }
   ]
  },

  "body:3": {
   "title": "Cold, with a sore throat",
   "cast": [
    { "id": "a", "ru": "Лена", "en": "Lena" },
    { "id": "b", "ru": "Борис", "en": "Boris" }
   ],
   "lines": [
    { "s": "b", "ru": "Лена, ты мёрзнешь?", "en": "Lena, are you cold?" },
    { "s": "a", "ru": "Мёрзну. И горло болит.", "en": "I am freezing. And my throat hurts." },
    { "s": "b", "ru": "Горло? Ты заболеешь.", "en": "Your throat? You will fall ill." },
    { "s": "a", "ru": "Может быть. Палец тоже болит.", "en": "Perhaps. My finger hurts too." },
    { "s": "b", "ru": "Палец! А желудок?", "en": "Your finger! And your stomach?" },
    { "s": "a", "ru": "Желудок не болит.", "en": "My stomach is fine." },
    { "s": "b", "ru": "Хорошо. А зубная боль?", "en": "Good. And toothache?" },
    { "s": "a", "ru": "Зубной боли нет.", "en": "No toothache." },
    { "s": "b", "ru": "А мозг? Он работает?", "en": "And your brain? Is that working?" },
    { "s": "a", "ru": "Мозг работает. Я же говорю.", "en": "My brain is working. I am talking, am I not?" },
    { "s": "b", "ru": "Говоришь. Но ты мёрзнешь.", "en": "You are. But you are freezing." },
    { "s": "a", "ru": "Мёрзну, Борис. И горло болит.", "en": "I am freezing, Boris. And my throat hurts." }
   ],
   "questions": [
    { "ask": "What is wrong with Lena?",
      "options": ["She is cold and her throat hurts", "Toothache", "Her stomach", "Nothing serious"],
      "answer": 0 },
    { "ask": "What does Boris think will happen?",
      "options": ["She will fall ill", "She will be fine", "She needs an operation", "She is imagining it"],
      "answer": 0 },
    { "ask": "What else hurts?",
      "options": ["A finger", "Her stomach", "A tooth", "Her head"], "answer": 0 },
    { "ask": "Why does Boris ask about her brain?",
      "options": ["He is teasing her", "He is a doctor", "She hit her head", "She was not making sense"],
      "answer": 0 },
    { "ask": "How does it end?",
      "options": ["She is still cold and sore", "She goes indoors", "The pain passes", "Boris fetches help"],
      "answer": 0 }
   ]
  },

  "body:4": {
   "title": "A tired household",
   "cast": [
    { "id": "a", "ru": "Нина", "en": "Nina" },
    { "id": "b", "ru": "Олег", "en": "Oleg" }
   ],
   "lines": [
    { "s": "b", "ru": "Нина, ты усталая?", "en": "Nina, are you tired?" },
    { "s": "a", "ru": "Усталая. Очень.", "en": "Tired. Very." },
