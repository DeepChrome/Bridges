    { "ask": "How often is Anya paid?",
      "options": ["Every day", "Every month", "Never", "When there is money"], "answer": 0 },
    { "ask": "Is Anya rich?",
      "options": ["No", "Yes", "She will not say", "Lena thinks so and she agrees"], "answer": 0 },
    { "ask": "What is the irony Anya points out?",
