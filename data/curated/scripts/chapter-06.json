  "core6:0": {
   "title": "The flat on this street",
   "cast": [
    { "id": "a", "ru": "Аня", "en": "Anya" },
    { "id": "b", "ru": "Борис", "en": "Boris" },
    { "id": "c", "ru": "Маша", "en": "Masha" }
   ],
   "lines": [
    { "s": "b", "ru": "Аня, где твоя квартира?", "en": "Anya, where is your flat?" },
    { "s": "a", "ru": "Квартира? На этой улице.", "en": "My flat? On this street." },
    { "s": "b", "ru": "На улице? Я тебя часто тут вижу.", "en": "On this street? I often see you here." },
    { "s": "a", "ru": "Часто. Я тут живу.", "en": "Often. I live here." },
    { "s": "b", "ru": "А я даже не знаю, где.", "en": "And I do not even know where." },
    { "s": "a", "ru": "Не знаешь? Вот она.", "en": "You do not? There it is." },
    { "s": "b", "ru": "Вот эта? Я её увижу?", "en": "That one? Will I get to see it?" },
    { "s": "a", "ru": "Увидишь. Но не сегодня.", "en": "You will. But not today." },
    { "s": "b", "ru": "У тебя такое лицо, Аня...", "en": "You have such a look on your face, Anya..." },
    { "s": "a", "ru": "Какое лицо, Борис?", "en": "What sort of look, Boris?" },
    { "s": "b", "ru": "Такое, что я всё вижу.", "en": "The sort that tells me everything." },
    { "s": "a", "ru": "Видишь? Хорошо.", "en": "You can see it? Good." },
    { "s": "c", "ru": "Аня! Я тоже на этой улице.", "en": "Anya! I am on this street too." },
    { "s": "b", "ru": "Маша? И ты тут живёшь?", "en": "Masha? Do you live here too?" },
    { "s": "c", "ru": "Живу. Вот моя квартира.", "en": "I do. That is my flat." }
   ],
   "questions": [
    { "ask": "Where does Anya live?",
      "options": ["On that street", "By the station", "Out of town", "She will not say"], "answer": 0 },
    { "ask": "How often does Boris see her there?",
      "options": ["Often", "Never before", "Once a year", "Only today"], "answer": 0 },
    { "ask": "Will he see the flat?",
      "options": ["Some day, but not today", "Right now", "Never", "Tomorrow"], "answer": 0 },
    { "ask": "What does he notice about her?",
      "options": ["The look on her face", "That she is in a hurry", "Her new coat", "Nothing"], "answer": 0 },
    { "ask": "Who turns out to live on the same street?",
      "options": ["Masha", "Boris", "Nobody else", "Anya's sister"], "answer": 0 }
   ]
  },

  "core6:1": {
   "title": "The dog and the business",
   "cast": [
    { "id": "a", "ru": "Катя", "en": "Katya" },
    { "id": "b", "ru": "Иван", "en": "Ivan" }
   ],
   "lines": [
    { "s": "a", "ru": "Иван, это твоя собака?", "en": "Ivan, is that your dog?" },
    { "s": "b", "ru": "Собака моя. И моей жены.", "en": "The dog is mine. And my wife's." },
    { "s": "a", "ru": "У тебя есть жена?", "en": "You have a wife?" },
    { "s": "b", "ru": "Есть, Катя. Уже год.", "en": "I have, Katya. For a year now." },
    { "s": "a", "ru": "Год! А собака?", "en": "A year! And the dog?" },
    { "s": "b", "ru": "Собака тоже наша.", "en": "The dog is ours too." },
    { "s": "a", "ru": "А что за дело у тебя?", "en": "And what is this business of yours?" },
    { "s": "b", "ru": "Дело? Я работаю. Это моё дело.", "en": "Business? I work. That is my business." },
    { "s": "a", "ru": "Если работа — это дело, то...", "en": "If work is business, then..." },
    { "s": "b", "ru": "То я всегда в деле.", "en": "Then I am always in business." },
    { "s": "a", "ru": "А голова? Что в голове?", "en": "And your head? What is in it?" },
    { "s": "b", "ru": "Голова? Если есть дело — есть голова.", "en": "My head? If there is business, there is a head." },
    { "s": "a", "ru": "Ты являешься... кем?", "en": "And you are... what, exactly?" },
    { "s": "b", "ru": "Я являюсь человеком, который работает.", "en": "I am a man who works." }
   ],
   "questions": [
    { "ask": "Whose dog is it?",
      "options": ["Ivan's and his wife's", "Katya's", "Nobody's", "His mother's"], "answer": 0 },
    { "ask": "How long has he been married?",
      "options": ["A year", "Ten years", "He is not married", "He does not say"], "answer": 0 },
    { "ask": "What does he say his business is?",
      "options": ["Simply working", "A shop", "The dog", "He has none"], "answer": 0 },
    { "ask": "What does he say is in his head?",
      "options": ["Business", "The dog", "His wife", "Nothing at all"],
      "answer": 0 },
    { "ask": "How does he describe himself at the end?",
      "options": ["A man who works", "A husband", "A dog owner", "A tired man"], "answer": 0 }
   ]
  },

  "core6:2": {
   "title": "Two hours, and the money",
   "cast": [
    { "id": "a", "ru": "Лена", "en": "Lena" },
    { "id": "b", "ru": "Пётр", "en": "Pyotr" }
   ],
   "lines": [
    { "s": "b", "ru": "Лена, ты была вчера тут?", "en": "Lena, were you here yesterday?" },
    { "s": "a", "ru": "Вчера? Да, была.", "en": "Yesterday? Yes, I was." },
    { "s": "b", "ru": "Два часа или более?", "en": "Two hours or more?" },
    { "s": "a", "ru": "Два часа. Не более.", "en": "Two hours. No more." },
    { "s": "b", "ru": "А без меня? Ничего?", "en": "And without me? Nothing happened?" },
    { "s": "a", "ru": "Ничего, Пётр. Всё было хорошо.", "en": "Nothing, Pyotr. It was all fine." },
    { "s": "b", "ru": "Хорошо... А деньги? Они под дверью?", "en": "Fine... And the money? Is it under the door?" },
    { "s": "a", "ru": "Под дверью. Как всегда.", "en": "Under the door. As always." },
    { "s": "b", "ru": "Как всегда... Их два?", "en": "As always... Are there two lots?" },
    { "s": "a", "ru": "Два. Или один. Не знаю.", "en": "Two. Or one. I do not know." },
    { "s": "b", "ru": "Ничего. Я найду.", "en": "Never mind. I will find it." },
    { "s": "a", "ru": "Найдёшь. Деньги под дверью.", "en": "You will. The money is under the door." }
   ],
   "questions": [
    { "ask": "When was Lena there?",
      "options": ["Yesterday", "Today", "Last week", "She was not"], "answer": 0 },
    { "ask": "For how long?",
      "options": ["Two hours", "All day", "A few minutes", "More than two hours"], "answer": 0 },
    { "ask": "Did anything happen while he was away?",
      "options": ["Nothing", "A great deal", "She will not say", "Someone came"], "answer": 0 },
    { "ask": "Where is the money?",
      "options": ["Under the door", "With Lena", "Lost", "In his pocket"], "answer": 0 },
    { "ask": "How many lots of it are there?",
      "options": ["She is not sure", "Exactly two", "Exactly one", "None"], "answer": 0 }
   ]
  },

  "core6:3": {
   "title": "Wine, and music she can play",
   "cast": [
    { "id": "a", "ru": "Пётр", "en": "Pyotr" },
    { "id": "b", "ru": "Юра", "en": "Yura" }
   ],
   "lines": [
    { "s": "b", "ru": "Пётр, ты пьёшь вино?", "en": "Pyotr, do you drink wine?" },
    { "s": "a", "ru": "Вино? Пью. Но не часто.", "en": "Wine? I do. But not often." },
    { "s": "b", "ru": "А что на столе?", "en": "And what is on the table?" },
    { "s": "a", "ru": "На столе всего вино.", "en": "On the table there is only wine." },
    { "s": "b", "ru": "Всего вино? А музыка?", "en": "Only wine? And music?" },
    { "s": "a", "ru": "Музыка есть. Я умею играть.", "en": "There is music. I can play." },
    { "s": "b", "ru": "Умеешь играть! Какая история!", "en": "You can play! What a story!" },
    { "s": "a", "ru": "История? Это не история.", "en": "A story? It is not a story." },
    { "s": "b", "ru": "История. Ты умеешь, а я нет.", "en": "It is. You can, and I cannot." },
    { "s": "a", "ru": "Ты тоже можешь. Если хочешь.", "en": "You could too. If you wanted to." },
    { "s": "b", "ru": "Хочу. Но музыка — это время.", "en": "I do want to. But music takes time." },
    { "s": "a", "ru": "Время, Юра. И вино на столе.", "en": "Time, Yura. And wine on the table." }
   ],
   "questions": [
    { "ask": "How often does Pyotr drink wine?",
      "options": ["Not often", "Every day", "Never", "Only with Yura"], "answer": 0 },
    { "ask": "What can he do?",
      "options": ["Play music", "Cook", "Sing", "Nothing special"], "answer": 0 },
    { "ask": "Can Yura play?",
      "options": ["No", "Yes, better than Pyotr", "He used to", "He will not say"], "answer": 0 },
    { "ask": "What does Pyotr tell Yura?",
      "options": ["He could learn if he wanted", "It is too late for him", "He should not bother", "To listen instead"],
      "answer": 0 },
    { "ask": "What stops Yura?",
      "options": ["It takes time", "Money", "He has no instrument", "Nothing"], "answer": 0 }
   ]
  },

