      "answer": 0 },    { "ask": "Who wrote to him?",
      "options": ["Someone he had talked to", "His boss at the office", "He does not know who", "Viktor, he says so"], "answer": 0 },
    { "ask": "What had they talked about?",
      "options": ["Work", "The letter", "Viktor", "Nothing in particular"], "answer": 0 },
    { "ask": "What did he ask for?",
      "options": ["An answer", "Money", "A meeting", "Nothing"], "answer": 0 }
   ]
  },

  "speech:1": {
   "title": "He has been ringing",
   "cast": [
    { "id": "a", "ru": "Лена", "en": "Lena" },
    { "id": "b", "ru": "Пётр", "en": "Pyotr" }
   ],
   "lines": [
    { "s": "b", "ru": "Лена, я звонил тебе вчера.", "en": "Lena, I rang you yesterday." },
    { "s": "a", "ru": "Звонил? Я не услышала.", "en": "You rang? I did not hear it." },
    { "s": "b", "ru": "Не услышала! А я звоню каждый день.", "en": "You did not hear! And I ring every day." },
    { "s": "a", "ru": "Каждый день... Тогда поговорим теперь.", "en": "Every day... Then let us talk now." },
    { "s": "b", "ru": "Поговорим. У меня есть разговор.", "en": "Let us. I have something to say." },
    { "s": "a", "ru": "Разговор? О чём?", "en": "Something to say? About what?" },
    { "s": "b", "ru": "Я прошу тебя. Только слушай.", "en": "I am asking you. Just listen." },
    { "s": "a", "ru": "Прошу... Ты просишь — я слушаю.", "en": "Asking... You ask, I listen." },
    { "s": "b", "ru": "Одна буква — и всё другое.", "en": "One letter — and everything is different." },
    { "s": "a", "ru": "Одна буква? Какая?", "en": "One letter? Which one?" },
    { "s": "b", "ru": "Позвони мне, и я скажу.", "en": "Ring me, and I will tell you." },
    { "s": "a", "ru": "Позвоню, Пётр. Сегодня.", "en": "I will ring, Pyotr. Today." }
   ],
   "questions": [
    { "ask": "How often has Pyotr been ringing?",
      "options": ["Every day", "Once", "Never", "Only yesterday"], "answer": 0 },
    { "ask": "Why has Lena not answered?",
      "options": ["She did not hear the calls", "She was angry with him then", "She has lost her phone", "She was away all week"],
      "answer": 0 },
    { "ask": "What does he ask of her?",
      "options": ["Just to listen", "To come at once", "To forgive him", "To stop ringing"],
      "answer": 0 },
    { "ask": "What does he say makes the difference?",
      "options": ["One letter", "One day", "One word from her", "Nothing"], "answer": 0 },
    { "ask": "How is it left?",
      "options": ["She will ring him today", "He will call her again", "They meet up tomorrow", "She refuses to ring"],
      "answer": 0 }
   ]
  },

  "speech:2": {
   "title": "It was not a discussion",
   "cast": [
    { "id": "a", "ru": "Нина", "en": "Nina" },
    { "id": "b", "ru": "Миша", "en": "Misha" }
   ],
   "lines": [
    { "s": "b", "ru": "Нина, что за дискуссия?", "en": "Nina, what was that discussion?" },
    { "s": "a", "ru": "Дискуссия? Это была беседа.", "en": "Discussion? It was a conversation." },
    { "s": "b", "ru": "Беседа! А кто кричал?", "en": "A conversation! And who was shouting?" },
    { "s": "a", "ru": "Кричали все. И я плакала.", "en": "Everybody shouted. And I cried." },
    { "s": "b", "ru": "Плакала? Почему?", "en": "You cried? Why?" },
    { "s": "a", "ru": "Так. Мы не договорились.", "en": "Because we could not agree." },
    { "s": "b", "ru": "Не договорились... А название?", "en": "Could not agree... And the name for it?" },
    { "s": "a", "ru": "Название? Его тоже нет.", "en": "The name? There is not one either." },
    { "s": "b", "ru": "Нет названия, нет дискуссии.", "en": "No name, no discussion." },
    { "s": "a", "ru": "Есть. Я обещаю.", "en": "There is one. I promise." },
    { "s": "b", "ru": "Обещаешь? Тогда договоримся.", "en": "You promise? Then let us come to an agreement." },
    { "s": "a", "ru": "Договоримся, Миша. И без беседы.", "en": "We will, Misha. And without a conversation." }
   ],
   "questions": [
    { "ask": "What does Nina call it?",
      "options": ["A conversation", "A discussion", "An argument", "A meeting"], "answer": 0 },
    { "ask": "What happened during it?",
      "options": ["Everyone shouted and she cried", "Nobody spoke a word the whole time", "They agreed almost at once", "It was called off early on"],
      "answer": 0 },
    { "ask": "Did they agree?",
      "options": ["No", "Yes", "Only about the name", "Misha does not ask"], "answer": 0 },
    { "ask": "What does she promise?",
      "options": ["That there is a name for it", "Not to cry about it again", "To apologise to everyone", "To keep quiet in future"],
      "answer": 0 },
    { "ask": "What do they settle on at the end?",
      "options": ["To agree without another talk", "To meet again and discuss it", "To ask somebody else to help", "To give up on it altogether"],
      "answer": 0 }
   ]
  },

  "speech:3": {
   "title": "After the quarrel, silence",
   "cast": [
    { "id": "a", "ru": "Соня", "en": "Sonya" },    { "id": "b", "ru": "Борис", "en": "Boris" },
    { "id": "c", "ru": "Нина", "en": "Nina" }
   ],
   "lines": [
    { "s": "b", "ru": "Соня, почему ты молчишь?", "en": "Sonya, why are you silent?" },
    { "s": "a", "ru": "Молчу. Тут тишина.", "en": "I am silent. There is silence here." },
    { "s": "b", "ru": "Тишина... А была ссора?", "en": "Silence... Was there a quarrel?" },
    { "s": "a", "ru": "Ссора была. Вчера.", "en": "There was a quarrel. Yesterday." },
    { "s": "b", "ru": "Вчера! И что обсуждалось?", "en": "Yesterday! And what was being discussed?" },
    { "s": "a", "ru": "Обсуждалось одно: обещание.", "en": "One thing was: a promise." },
    { "s": "b", "ru": "Обещание? Чьё?", "en": "A promise? Whose?" },
    { "s": "a", "ru": "Его. Он проговорил всё.", "en": "His. He said the whole of it." },
    { "s": "b", "ru": "Проговорил — и что теперь?", "en": "He said it — and now what?" },
    { "s": "a", "ru": "Теперь я молчу.", "en": "Now I am silent." },
    { "s": "b", "ru": "Молчишь. Но надо объясняться.", "en": "You are silent. But it needs talking out." },    { "s": "a", "ru": "Объясняться? Не сегодня, Борис.", "en": "Talking out? Not today, Boris." },
    { "s": "c", "ru": "Ссора была и у меня.", "en": "I had a quarrel too." },
    { "s": "b", "ru": "Нина! И ты молчишь?", "en": "Nina! Are you silent too?" },
    { "s": "c", "ru": "Не молчу. Я объясняюсь.", "en": "I am not. I talk it out." }
   ],
   "questions": [
    { "ask": "Why is Sonya not speaking?",
      "options": ["There was a quarrel yesterday", "She is ill and cannot speak", "Boris has annoyed her badly", "She is thinking about it"],
      "answer": 0 },
    { "ask": "What was the quarrel about?",
      "options": ["A promise", "Money", "Boris", "Nothing in particular"], "answer": 0 },
    { "ask": "Whose promise was it?",
      "options": ["The other man's", "Boris's, it seems", "Sonya's, she says", "Nobody's at all"], "answer": 0 },
    { "ask": "What does Boris think should happen?",
      "options": ["It should be talked out", "She should stay silent", "She should leave", "He should speak to the man"],
      "answer": 0 },    { "ask": "What does Nina do about her own quarrel?",
      "options": ["She talks it out", "She stays silent too", "She left", "She agrees with Sonya"], "answer": 0 }
   ]
  },

  "speech:4": {
   "title": "Who shouted",
   "cast": [
    { "id": "a", "ru": "Аня", "en": "Anya" },
    { "id": "b", "ru": "Иван", "en": "Ivan" }
   ],
   "lines": [
    { "s": "b", "ru": "Аня, ты услышала крик?", "en": "Anya, did you hear the shout?" },
    { "s": "a", "ru": "Крик? Услышала. Кто закричал?", "en": "The shout? I heard it. Who shouted?" },
    { "s": "b", "ru": "Тот, который всё утверждает.", "en": "The one who is always making claims." },
    { "s": "a", "ru": "Утверждает... И он заговорил?", "en": "Making claims... And then he started talking?" },
    { "s": "b", "ru": "Заговорил. И беседовал с нами.", "en": "He did. And talked with us." },
    { "s": "a", "ru": "С вами? О чём?", "en": "With you? About what?" },
    { "s": "b", "ru": "Он указывал на дверь.", "en": "He was pointing at the door." },
    { "s": "a", "ru": "Указывал на дверь! И что?", "en": "Pointing at the door! And then?" },
    { "s": "b", "ru": "И назвал меня. Просто назвал.", "en": "And he named me. Just named me." },
    { "s": "a", "ru": "Назвал... Ты закричал?", "en": "Named you... Did you shout?" },
    { "s": "b", "ru": "Не закричал. Я беседую, не кричу.", "en": "I did not. I talk, I do not shout." },
    { "s": "a", "ru": "Беседуешь. Вот и всё, Иван.", "en": "You talk. That is that, then, Ivan." }
   ],
   "questions": [
    { "ask": "Who shouted?",
      "options": ["The man who makes claims", "Ivan, by his own account", "Anya, she admits it now", "Nobody shouted at all"], "answer": 0 },
    { "ask": "What did he do after shouting?",
      "options": ["Talked with them", "Left", "Shouted again", "Wrote a letter"], "answer": 0 },
    { "ask": "What was he pointing at?",
      "options": ["The door", "Ivan", "A letter", "Nothing"], "answer": 0 },
    { "ask": "Did Ivan shout back?",
      "options": ["No", "Yes", "He left the room", "He does not say"], "answer": 0 },
    { "ask": "How does Ivan describe himself?",
      "options": ["Someone who talks, not shouts", "Someone who shouts a great deal", "A quiet man who says little", "The one who is in the wrong"],
      "answer": 0 }
   ]
  },

  "speech:5": {
   "title": "One word to translate",
   "cast": [
    { "id": "a", "ru": "Катя", "en": "Katya" },
    { "id": "b", "ru": "Олег", "en": "Oleg" }
   ],
   "lines": [
    { "s": "a", "ru": "Олег, повтори это.", "en": "Oleg, say that again." },
    { "s": "b", "ru": "Повторю. Но ты слушай.", "en": "I will. But listen." },
    { "s": "a", "ru": "Слушаю. Объясни сам.", "en": "I am listening. Explain it yourself." },
    { "s": "b", "ru": "Объясню. Мы обсуждаем наименование.", "en": "I will. We are discussing a name." },
    { "s": "a", "ru": "Наименование? Какое?", "en": "A name? Which one?" },
    { "s": "b", "ru": "То, что надо перевести.", "en": "The one that has to be translated." },
    { "s": "a", "ru": "Перевести! На русский?", "en": "Translated! Into Russian?" },
    { "s": "b", "ru": "На русский. И повторить.", "en": "Into Russian. And repeated." },
    { "s": "a", "ru": "Повторить... Сколько раз?", "en": "Repeated... How many times?" },
    { "s": "b", "ru": "Два раза. Или больше.", "en": "Twice. Or more." },
    { "s": "a", "ru": "Тогда объясни ещё раз.", "en": "Then explain it once more." },
    { "s": "b", "ru": "Объясняю, Катя. Мы обсуждаем одно слово.", "en": "I am explaining, Katya. We are discussing one word." }
   ],
   "questions": [
    { "ask": "What are they discussing?",
      "options": ["A single word", "A whole letter", "A meeting", "A price"], "answer": 0 },
    { "ask": "What has to be done with it?",
      "options": ["Translated into Russian", "Forgotten about entirely", "Shouted out to everyone", "Written down carefully"], "answer": 0 },
    { "ask": "How many times must it be repeated?",
      "options": ["Twice or more", "Once", "Never", "Until Katya understands"], "answer": 0 },
    { "ask": "Who keeps asking for an explanation?",
      "options": ["Katya", "Oleg", "Both", "Neither"], "answer": 0 },
    { "ask": "How patient is Oleg?",
      "options": ["He keeps explaining", "He walks off at last", "He refuses to go on", "He shouts at her"], "answer": 0 }
   ]
  },

