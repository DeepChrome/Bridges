 "lessons": {
  "core7:0": {
   "title": "A year over one book",
   "cast": [
    { "id": "a", "ru": "Аня", "en": "Anya" },
    { "id": "b", "ru": "Миша", "en": "Misha" }
   ],
   "lines": [
    { "s": "b", "ru": "Аня, ты останешься?", "en": "Anya, are you going to stay?" },
    { "s": "a", "ru": "Останусь. Правда, не знаю, на сколько.", "en": "I will stay. Though I do not know for how long." },
    { "s": "b", "ru": "Правда? А многие уже дома.", "en": "Really? Most people are home already." },
    { "s": "a", "ru": "Многие. Но я пишу.", "en": "Most people. But I am writing." },
    { "s": "b", "ru": "Пишешь? Что ты пишешь?", "en": "Writing? What are you writing?" },
    { "s": "a", "ru": "Я работаю над книгой уже год.", "en": "I have been working on a book for a year." },
    { "s": "b", "ru": "Над книгой! И ты боишься?", "en": "On a book! And you are afraid?" },
    { "s": "a", "ru": "Боюсь. Многие боятся.", "en": "I am afraid. Many people are." },
    { "s": "b", "ru": "Я могу помочь. Правда.", "en": "I can help. Really." },
    { "s": "a", "ru": "Поможешь? Как?", "en": "Help? How?" },
    { "s": "b", "ru": "Останусь тут. С тобой.", "en": "I will stay here. With you." },
    { "s": "a", "ru": "Останься, Миша. Я пишу.", "en": "Stay then, Misha. I am writing." }
   ],
   "questions": [
    { "ask": "Why is Anya staying late?",
      "options": ["She is writing", "She is waiting for Misha", "She has nowhere to go", "She is reading"],
      "answer": 0 },
    { "ask": "How long has she worked on it?",
      "options": ["A year", "A month", "All night", "She does not say"], "answer": 0 },
    { "ask": "How does she feel about it?",
      "options": ["Afraid", "Delighted", "Bored", "Sure of herself"], "answer": 0 },
    { "ask": "What does Misha offer?",
      "options": ["To stay with her", "To read it", "To write it for her", "To take her home"],
      "answer": 0 },
    { "ask": "Does she accept?",
      "options": ["Yes", "No", "She does not answer", "She sends him home"], "answer": 0 }
   ]
  },

  "core7:1": {
   "title": "A small television, all night",
   "cast": [
    { "id": "a", "ru": "Катя", "en": "Katya" },    { "id": "b", "ru": "Борис", "en": "Boris" },
    { "id": "c", "ru": "Юра", "en": "Yura" }
   ],
   "lines": [
    { "s": "b", "ru": "Катя, вот телевизор.", "en": "Katya, here is the television." },
    { "s": "a", "ru": "Телевизор? Маленький.", "en": "The television? It is small." },
    { "s": "b", "ru": "Маленький, но работает. Всю ночь.", "en": "Small, but it works. All night." },
    { "s": "a", "ru": "Всю ночь! А ты?", "en": "All night! And you?" },
    { "s": "b", "ru": "Я? Я просто смотрю.", "en": "Me? I just watch." },
    { "s": "a", "ru": "Просто смотришь... А что?", "en": "Just watch... Watch what?" },
    { "s": "b", "ru": "Я забыл. Правда.", "en": "I have forgotten. Honestly." },
    { "s": "a", "ru": "Забыл? Расскажи мне.", "en": "Forgotten? Tell me about it." },
    { "s": "b", "ru": "Расскажу. Но это маленькая история.", "en": "I will. But it is a small story." },
    { "s": "a", "ru": "Борис, маленькая история — тоже история.", "en": "Boris, a small story is still a story." },
    { "s": "b", "ru": "Вот. Была ночь, и телевизор.", "en": "Here it is. There was a night, and a television." },    { "s": "a", "ru": "И всё? Ты просто забыл.", "en": "Is that all? You simply forgot." },
    { "s": "c", "ru": "Была ночь. Я тоже смотрел.", "en": "There was a night. I was watching too." },
    { "s": "a", "ru": "Юра? И ты смотрел телевизор?", "en": "Yura? You were watching the television too?" },
    { "s": "c", "ru": "Смотрел. И тоже забыл.", "en": "I was. And I have forgotten too." }
   ],
   "questions": [
    { "ask": "What are they talking about?",
      "options": ["A small television", "A book", "A night out", "A story Katya told"], "answer": 0 },
    { "ask": "How long does Boris watch it?",
      "options": ["All night", "An hour", "He does not watch it", "Only in the day"], "answer": 0 },
    { "ask": "Can he say what he watches?",
      "options": ["No, he has forgotten", "Yes, in great detail", "He will not say now", "Katya tells him it"],
      "answer": 0 },
    { "ask": "What does Katya ask him to do?",
      "options": ["Tell her the story", "Turn the set off", "Go to bed early", "Lend it to her"], "answer": 0 },    { "ask": "What does Yura add at the end?",
      "options": ["He watched too, and forgot too", "He remembers all of it clearly", "He was asleep the whole time", "He has no television at all"],
      "answer": 0 }
   ]
  },

  "core7:2": {
   "title": "Through the window, or tomorrow",
   "cast": [
    { "id": "a", "ru": "Лена", "en": "Lena" },
    { "id": "b", "ru": "Олег", "en": "Oleg" }
   ],
   "lines": [
    { "s": "b", "ru": "Лена, ты готова?", "en": "Lena, are you ready?" },
    { "s": "a", "ru": "Готова. А ты?", "en": "Ready. And you?" },
    { "s": "b", "ru": "Тогда идём. Через окно?", "en": "Then let us go. Through the window?" },
    { "s": "a", "ru": "Через окно? Олег, оно небольшое!", "en": "Through the window? Oleg, it is small!" },
    { "s": "b", "ru": "Небольшое. Но мы пройдём.", "en": "Small. But we will get through." },
    { "s": "a", "ru": "Пройдём... А если нет?", "en": "We will get through... And if we do not?" },
    { "s": "b", "ru": "Тогда завтра. Через дверь.", "en": "Then tomorrow. Through the door." },
    { "s": "a", "ru": "Через дверь? Это не то же самое.", "en": "Through the door? That is not the same thing." },
    { "s": "b", "ru": "Не то же. Но ты готова.", "en": "Not the same. But you are ready." },
    { "s": "a", "ru": "Готова. Окно небольшое, а дом огромный.", "en": "Ready. The window is small and the house is enormous." },
    { "s": "b", "ru": "Огромный дом, небольшое окно.", "en": "An enormous house, a small window." },
    { "s": "a", "ru": "Тогда завтра, Олег.", "en": "Tomorrow, then, Oleg." }
   ],
   "questions": [
    { "ask": "What does Oleg suggest?",
      "options": ["Going through the window", "Going through the door", "Waiting a year", "Staying in"],
      "answer": 0 },
    { "ask": "What is Lena's objection?",
      "options": ["The window is too small", "It is too dark to see", "She is not ready yet", "The house is too big"],
      "answer": 0 },
    { "ask": "What is his other plan?",
      "options": ["The door, tomorrow", "The door, right now", "To give up on it", "Another window"], "answer": 0 },
    { "ask": "What does Lena say about the house?",
      "options": ["It is enormous", "It is small", "It is not theirs", "It is empty"], "answer": 0 },
    { "ask": "What do they decide?",
      "options": ["To leave it until tomorrow", "To climb through the window", "To use the door right now", "To do nothing about it"],
      "answer": 0 }
   ]
  },

  "core7:3": {
   "title": "Two roubles now",
   "cast": [
    { "id": "a", "ru": "Нина", "en": "Nina" },
    { "id": "b", "ru": "Юра", "en": "Yura" }
   ],
   "lines": [
    { "s": "b", "ru": "Нина, сколько это стоит?", "en": "Nina, how much does this cost?" },
    { "s": "a", "ru": "Теперь? Два рубля.", "en": "Now? Two roubles." },
    { "s": "b", "ru": "Два рубля! А вчера?", "en": "Two roubles! And yesterday?" },
    { "s": "a", "ru": "Вчера был другой случай.", "en": "Yesterday was a different matter." },
    { "s": "b", "ru": "Другой случай? Какой?", "en": "A different matter? How so?" },
    { "s": "a", "ru": "Тот учёный. Он сам дал рубль.", "en": "That scientist. He put in a rouble himself." },
    { "s": "b", "ru": "Учёный сам дал! Я его знаю?", "en": "The scientist put it in himself! Do I know him?" },
    { "s": "a", "ru": "Знаешь. У него такие глаза.", "en": "You do. He has those eyes." },
    { "s": "b", "ru": "Глаза... Теперь я знаю.", "en": "The eyes... Now I know the one." },
    { "s": "a", "ru": "Знаешь. Он тут часто.", "en": "You do. He is here often." },
    { "s": "b", "ru": "А теперь? Два рубля?", "en": "And now? Two roubles?" },
    { "s": "a", "ru": "Два рубля, Юра. Другого случая нет.", "en": "Two roubles, Yura. There is no other arrangement." }
   ],
   "questions": [
    { "ask": "What does it cost now?",
      "options": ["Two roubles", "Nothing", "More than yesterday", "Nina will not say"], "answer": 0 },
    { "ask": "Why was yesterday different?",
      "options": ["A scientist paid himself", "There was a sale on then", "The place was closed up", "Yura was not there then"],
      "answer": 0 },
    { "ask": "How does Yura place the man?",
      "options": ["By his eyes", "By his name", "By his coat", "He never does"], "answer": 0 },
    { "ask": "How often is the scientist there?",
      "options": ["Often", "Once", "Never again", "Only yesterday"], "answer": 0 },
    { "ask": "Will Yura get the same arrangement?",
      "options": ["No", "Yes", "If he asks again", "Nina is thinking about it"], "answer": 0 }
   ]
  },

  "core7:4": {
   "title": "The price has changed",
   "cast": [    { "id": "a", "ru": "Иван", "en": "Ivan" },
    { "id": "b", "ru": "Виктор", "en": "Viktor" }
   ],
   "lines": [
    { "s": "b", "ru": "Иван, ты слушаешь?", "en": "Ivan, are you listening?" },
    { "s": "a", "ru": "Слушаю. Говори.", "en": "I am. Go on." },
    { "s": "b", "ru": "Цена. Она теперь другая.", "en": "The price. It is different now." },
    { "s": "a", "ru": "Другая цена? Больше?", "en": "A different price? Higher?" },
    { "s": "b", "ru": "Больше. Два раза.", "en": "Higher. Twice as much." },
    { "s": "a", "ru": "Два раза! Я не слушаю.", "en": "Twice! I am not listening." },
    { "s": "b", "ru": "Слушай. Это не моя цена.", "en": "Listen. It is not my price." },
    { "s": "a", "ru": "Не твоя? А чья?", "en": "Not yours? Whose then?" },
    { "s": "b", "ru": "Их. Они её сделали.", "en": "Theirs. They set it." },
    { "s": "a", "ru": "Сделали... И что теперь?", "en": "They set it... And now what?" },
    { "s": "b", "ru": "Теперь цена такая. Или нет.", "en": "Now that is the price. Or it is not." },
    { "s": "a", "ru": "Я слушаю, Виктор. Но цена большая.", "en": "I am listening, Viktor. But the price is steep." }
   ],
   "questions": [
    { "ask": "What has happened to the price?",
      "options": ["It has doubled", "It has halved", "It is unchanged", "It was cancelled"], "answer": 0 },
    { "ask": "Who set it?",
      "options": ["Somebody else, not Viktor", "Viktor himself, he admits", "Ivan, without knowing it", "Nobody seems to know it"], "answer": 0 },    { "ask": "How does Ivan react at first?",
      "options": ["He refuses to listen", "He agrees to it at once", "He offers to pay it", "He laughs it off"], "answer": 0 },
    { "ask": "What are the choices?",
      "options": ["Take the price or leave it", "Wait a year for it to fall", "Complain to somebody else", "Pay half of it and wait"], "answer": 0 },
    { "ask": "Where does it end?",
      "options": ["He is listening, but unhappy", "They pay it without a word", "They refuse it altogether", "Viktor leaves in a temper"],
      "answer": 0 }
   ]
  },

