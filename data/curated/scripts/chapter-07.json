  "business:1": {
   "title": "Budget, credit and a fund",
   "cast": [
    { "id": "a", "ru": "Нина", "en": "Nina" },    { "id": "b", "ru": "Пётр", "en": "Pyotr" },
    { "id": "c", "ru": "Виктор", "en": "Viktor" }
   ],
   "lines": [
    { "s": "b", "ru": "Нина, какой у вас бюджет?", "en": "Nina, what is your budget?" },
    { "s": "a", "ru": "Бюджет? Небольшой. Есть кредит.", "en": "The budget? Small. There is credit." },
    { "s": "b", "ru": "Кредит! А доход?", "en": "Credit! And income?" },
