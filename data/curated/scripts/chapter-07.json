   "lines": [
    { "s": "b", "ru": "Соня, ты этим интересуешься?", "en": "Sonya, does this interest you?" },
    { "s": "a", "ru": "Интересуюсь. У меня есть мысль.", "en": "It does. I have a thought." },
    { "s": "b", "ru": "Мысль? Какая? Я любопытный.", "en": "A thought? What is it? I am curious." },
    { "s": "a", "ru": "Любопытный! Мысль небольшая.", "en": "Curious! It is a small thought." },
    { "s": "b", "ru": "Небольшая мысль — это тоже мысль.", "en": "A small thought is still a thought." },
    { "s": "a", "ru": "Так. Я нуждаюсь в тебе.", "en": "Quite. I need you." },
    { "s": "b", "ru": "Нуждаешься? Правда?", "en": "You need me? Really?" },
    { "s": "a", "ru": "Правда. Память у меня не та.", "en": "Really. My memory is not what it was." },
    { "s": "b", "ru": "Не та память? Это тревожный случай.", "en": "Not what it was? That is a worrying business." },
    { "s": "a", "ru": "Тревожный. Но я полюбила это дело.", "en": "Worrying. But I have come to love the work." },
    { "s": "b", "ru": "Полюбила! Тогда я помогу.", "en": "Come to love it! Then I will help." },
    { "s": "a", "ru": "Поможешь. Вот моя мысль, Олег.", "en": "You will. That was my thought, Oleg." }
   ],
   "questions": [
    { "ask": "What has Sonya got?",
      "options": ["A thought to share", "A complaint to make", "Nothing much to say", "A new job in town"],
      "answer": 0 },
    { "ask": "What does she need Oleg for?",
      "options": ["Her memory is failing", "Money, she admits it", "A lift into the town", "Company, she says so"], "answer": 0 },
    { "ask": "How does Oleg describe that?",
      "options": ["Worrying", "Funny", "Normal", "Her own fault"], "answer": 0 },
    { "ask": "How does she feel about the work?",
      "options": ["She has come to love it", "She has come to hate it", "It bores her completely", "She is leaving it soon"],
      "answer": 0 },
    { "ask": "What was her thought all along?",
      "options": ["Getting him to help", "Leaving the job", "Asking for money", "Telling him the truth"],
      "answer": 0 }
   ]
  },

  "emotion:5": {
   "title": "What is worrying her",
   "cast": [
    { "id": "a", "ru": "Аня", "en": "Anya" },
    { "id": "b", "ru": "Юра", "en": "Yura" }
   ],
   "lines": [
    { "s": "b", "ru": "Аня, ты грустная?", "en": "Anya, are you sad?" },
    { "s": "a", "ru": "Грустная. Я волнуюсь.", "en": "Sad. I am worried." },
    { "s": "b", "ru": "Волнуешься? Что тебя беспокоит?", "en": "Worried? What is troubling you?" },
    { "s": "a", "ru": "Беспокоит одно. Я вспомнила его.", "en": "One thing. I remembered him." },
    { "s": "b", "ru": "Его? Кого?", "en": "Him? Who?" },
    { "s": "a", "ru": "Того, который был тут. Влюблённый.", "en": "The one who was here. The one in love." },
    { "s": "b", "ru": "Влюблённый? В тебя?", "en": "In love? With you?" },
    { "s": "a", "ru": "В меня. И это меня беспокоит.", "en": "With me. And that is what troubles me." },
    { "s": "b", "ru": "Беспокоит... А ты?", "en": "It troubles you... And you?" },
    { "s": "a", "ru": "Я? Я грустная. И всё.", "en": "Me? I am sad. That is all." },
    { "s": "b", "ru": "Не волнуйся. Я тут.", "en": "Do not worry. I am here." },
    { "s": "a", "ru": "Тут, Юра. Я это помню.", "en": "Here, Yura. I do remember that." }
   ],
   "questions": [
    { "ask": "How is Anya?",
      "options": ["Sad and worried", "Cheerful enough", "Angry with Yura", "Frightened now"], "answer": 0 },
    { "ask": "What has she remembered?",
      "options": ["A man who was in love with her", "An argument she had with him", "Something she forgot to do", "A dream she had last night"],
      "answer": 0 },
    { "ask": "Who was he in love with?",
      "options": ["Anya", "Somebody else", "Nobody", "She will not say"], "answer": 0 },
    { "ask": "What does Yura say?",
      "options": ["Not to worry, he is there", "That she should forget him", "That he is jealous", "Nothing"],
      "answer": 0 },
    { "ask": "How does she answer him?",
      "options": ["She says she remembers that", "She sends him away at once", "She laughs it off at him", "She changes the subject"],
      "answer": 0 }
   ]
  },

  "speech:0": {
   "title": "The letter she has not answered",
   "cast": [    { "id": "a", "ru": "Олег", "en": "Oleg" },
    { "id": "b", "ru": "Виктор", "en": "Viktor" }
   ],
   "lines": [
    { "s": "b", "ru": "Олег, можно спросить?", "en": "Oleg, may I ask you something?" },
    { "s": "a", "ru": "Спроси, Виктор. Я отвечу.", "en": "Ask, Viktor. I will answer." },
    { "s": "b", "ru": "Ты получил письмо?", "en": "Did you get the letter?" },
    { "s": "a", "ru": "Письмо? Получил. Но я не ответил.", "en": "The letter? I got it. But I did not answer." },
    { "s": "b", "ru": "Не ответил! Почему?", "en": "You did not answer! Why?" },
    { "s": "a", "ru": "Не могу объяснять. Это не просто.", "en": "I cannot explain. It is not simple." },
    { "s": "b", "ru": "Не просто... А кто тебе пишет?", "en": "Not simple... And who writes to you?" },
    { "s": "a", "ru": "Тот, с кем я разговаривал.", "en": "The man I was talking to." },
    { "s": "b", "ru": "Разговаривал! И о чём?", "en": "Talking to! And about what?" },
    { "s": "a", "ru": "Я рассказывал о работе.", "en": "I was telling him about work." },
    { "s": "b", "ru": "О работе. И он попросил, чтобы ты ответил?", "en": "About work. And he asked you to answer?" },
    { "s": "a", "ru": "Попросил. А я не ответил.", "en": "He did. And I have not answered." }
   ],
   "questions": [    { "ask": "What has Oleg not done?",
