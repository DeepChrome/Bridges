      "options": ["An offensive", "A retreat", "A parade", "Nothing yet"], "answer": 0 },
    { "ask": "Who ordered it?",
      "options": ["The colonel", "The officers", "A general", "Nobody"], "answer": 0 },
    { "ask": "Where are the officers?",
      "options": ["With the regiment", "At headquarters", "Gone", "With Nina"], "answer": 0 },
    { "ask": "What have they been told to do?",
      "options": ["Wait", "Attack", "Fall back", "Follow the colonel"], "answer": 0 },
    { "ask": "What is the contradiction Misha points out?",
      "options": ["They wait while the attack runs", "The colonel is not there at all", "There is no pistol to be had", "Nobody gave an order at all"],
      "answer": 0 }
   ]
  },

  "military:4": {
   "title": "A battle lasting all day",
   "cast": [
    { "id": "a", "ru": "Соня", "en": "Sonya" },
    { "id": "b", "ru": "Олег", "en": "Oleg" }
   ],
   "lines": [
    { "s": "b", "ru": "Соня, кто атакует?", "en": "Sonya, who is attacking?" },
    { "s": "a", "ru": "Атакует войско. Генерал приказал.", "en": "The army is attacking. The general ordered it." },
    { "s": "b", "ru": "Генерал! А битва?", "en": "The general! And the battle?" },
    { "s": "a", "ru": "Битва идёт. Уже день.", "en": "The battle is going on. A day now." },
    { "s": "b", "ru": "День! А бомба?", "en": "A day! And the bomb?" },
