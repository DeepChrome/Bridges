  "core8:0": {
   "title": "The computer her mother bought",
   "cast": [
    { "id": "a", "ru": "Аня", "en": "Anya" },
    { "id": "b", "ru": "Борис", "en": "Boris" }
   ],
   "lines": [
    { "s": "b", "ru": "Аня, это твой компьютер?", "en": "Anya, is that your computer?" },
    { "s": "a", "ru": "Да, мой. Он не новый.", "en": "Yes, mine. It is not new." },
    { "s": "b", "ru": "Не новый, но главный?", "en": "Not new, but the main one?" },
    { "s": "a", "ru": "Главный. На нём вся работа.", "en": "The main one. All the work is on it." },
    { "s": "b", "ru": "А кто его купил?", "en": "And who bought it?" },
    { "s": "a", "ru": "Моя мать. Она всё может.", "en": "My mother. She can do anything." },
    { "s": "b", "ru": "Мать! А продукт?", "en": "Your mother! And the product?" },
    { "s": "a", "ru": "Продукт ещё не готов.", "en": "The product is not ready yet." },
    { "s": "b", "ru": "Не готов? А когда это началось?", "en": "Not ready? And when did it start?" },
    { "s": "a", "ru": "Началось вчера. Работа идёт.", "en": "It started yesterday. The work is going on." },
    { "s": "b", "ru": "А молодой человек тоже работает?", "en": "And the young man is working too?" },
    { "s": "a", "ru": "Да, Борис. Он самый молодой.", "en": "Yes, Boris. He is the youngest." }
   ],
   "questions": [
    { "ask": "Whose computer is it?",
      "options": ["Anya's", "Boris's", "Her mother's", "The company's"], "answer": 0 },
    { "ask": "Who bought it?",
      "options": ["Her mother", "She did", "Boris", "Her employer"], "answer": 0 },
    { "ask": "Is the product finished?",
      "options": ["Not yet", "Yes", "It was cancelled", "She does not say"], "answer": 0 },
    { "ask": "When did the work begin?",
      "options": ["Yesterday", "A year ago", "Today", "It has not begun"], "answer": 0 },
    { "ask": "What does she say about the young man?",
      "options": ["He is the youngest and works", "He has left the firm for good", "He does nothing at all there", "He is her younger brother"],
      "answer": 0 }
   ]
  },

  "core8:1": {
   "title": "Nobody heard him",
   "cast": [
    { "id": "a", "ru": "Катя", "en": "Katya" },
    { "id": "b", "ru": "Миша", "en": "Misha" }
   ],
   "lines": [
    { "s": "b", "ru": "Катя, ты слышишь самолёт?", "en": "Katya, can you hear the aircraft?" },
    { "s": "a", "ru": "Слышу. Он всегда тут.", "en": "I can. It is always here." },
    { "s": "b", "ru": "Всегда! А кто в комнате?", "en": "Always! And who is in the room?" },
    { "s": "a", "ru": "Никто. Никто не пришёл.", "en": "Nobody. Nobody came." },
    { "s": "b", "ru": "Никто? А я вызвал всех.", "en": "Nobody? But I called everyone in." },
    { "s": "a", "ru": "Вызвал, Миша? И никто не слышал.", "en": "You called them, Misha? And nobody heard." },
    { "s": "b", "ru": "Не слышали... А ты ходишь в магазин?", "en": "They did not hear... And do you go to the shop?" },
    { "s": "a", "ru": "Хожу. Каждый день.", "en": "I do. Every day." },
    { "s": "b", "ru": "Каждый день в магазин!", "en": "To the shop every day!" },
    { "s": "a", "ru": "Да. А самолёт — каждый час.", "en": "Yes. And the aircraft — every hour." },
    { "s": "b", "ru": "Самолёт каждый час, Катя!", "en": "An aircraft every hour, Katya!" },
    { "s": "a", "ru": "Каждый час. Я уже не слышу.", "en": "Every hour. I do not hear it any more." }
   ],
   "questions": [
    { "ask": "What can be heard?",
      "options": ["An aircraft", "A telephone", "A crowd", "Nothing at all"], "answer": 0 },
    { "ask": "Who is in the room?",
      "options": ["Nobody at all", "Everyone he called", "Only Katya is", "A few people"], "answer": 0 },
    { "ask": "What had Misha done?",
      "options": ["Called everyone in", "Gone to the shop", "Waited outside", "Nothing"], "answer": 0 },
    { "ask": "How often does Katya go to the shop?",
      "options": ["Every day", "Once a week", "Never", "Every hour"], "answer": 0 },
    { "ask": "Why does the aircraft not bother her?",
      "options": ["She is used to it", "It is far away", "She is deaf", "It only comes at night"],
      "answer": 0 }
   ]
  },

  "core8:2": {
   "title": "The programme is running",
   "cast": [
    { "id": "a", "ru": "Лена", "en": "Lena" },    { "id": "b", "ru": "Олег", "en": "Oleg" },
    { "id": "c", "ru": "Аня", "en": "Anya" }
   ],
   "lines": [
    { "s": "b", "ru": "Лена, что произошло?", "en": "Lena, what has happened?" },
    { "s": "a", "ru": "Произошло? Ничего. Пока.", "en": "Happened? Nothing. So far." },
    { "s": "b", "ru": "Пока! А программа?", "en": "So far! And the programme?" },
    { "s": "a", "ru": "Программа работает. Быстро.", "en": "The programme is running. Fast." },
    { "s": "b", "ru": "Быстро? А помощь?", "en": "Fast? And help?" },
    { "s": "a", "ru": "Помощь? Она всегда идёт.", "en": "Help? It is always on the way." },
    { "s": "b", "ru": "Идёт? Я вернусь.", "en": "On the way? I will come back." },
    { "s": "a", "ru": "Вернёшься? Когда?", "en": "Come back? When?" },
    { "s": "b", "ru": "Быстро. Через час.", "en": "Quickly. In an hour." },
    { "s": "a", "ru": "Через час... Весь мир ждёт.", "en": "In an hour... The whole world is waiting." },
    { "s": "b", "ru": "Весь мир! Это программа.", "en": "The whole world! It is only a programme." },    { "s": "a", "ru": "Программа, Олег. Пока.", "en": "A programme, Oleg. See you." },
    { "s": "c", "ru": "Лена, помощь тут.", "en": "Lena, the help is here." },
    { "s": "a", "ru": "Аня? Так быстро?", "en": "Anya? So fast?" },
    { "s": "c", "ru": "Быстро. Программа ждёт.", "en": "Fast. The programme is waiting." }
   ],
   "questions": [
    { "ask": "Has anything gone wrong?",
      "options": ["Not so far", "Yes, badly", "The programme stopped", "Lena will not say"],
      "answer": 0 },
    { "ask": "How is the programme running?",
      "options": ["Fast", "Slowly", "Not at all", "Nobody has checked"], "answer": 0 },
    { "ask": "What does Lena say about help?",
      "options": ["It is always on the way", "She will ask for it later", "It never comes at all", "She needs none of it"], "answer": 0 },
    { "ask": "When will Oleg be back?",
      "options": ["In an hour", "Tomorrow", "Never", "He is not leaving"], "answer": 0 },    { "ask": "Who arrives at the end?",
      "options": ["Anya, with the help", "Oleg, back early on", "Nobody arrives then", "The boss himself"], "answer": 0 }
   ]
  },

  "core8:3": {
   "title": "Cooking instead of sleeping",
   "cast": [
    { "id": "a", "ru": "Нина", "en": "Nina" },
    { "id": "b", "ru": "Пётр", "en": "Pyotr" }
   ],
   "lines": [
    { "s": "b", "ru": "Нина, ты спишь?", "en": "Nina, are you asleep?" },
    { "s": "a", "ru": "Не сплю. Я готовлю.", "en": "Not asleep. I am cooking." },
    { "s": "b", "ru": "Готовишь? А телефон?", "en": "Cooking? And your telephone?" },
    { "s": "a", "ru": "Телефон? Я его не взяла.", "en": "My telephone? I did not take it." },
    { "s": "b", "ru": "Не взяла! А несколько вещей?", "en": "You did not! And the few things?" },
    { "s": "a", "ru": "Несколько вещей тут. Я их даю тебе.", "en": "The few things are here. I am giving them to you." },
    { "s": "b", "ru": "Даёшь? Мне?", "en": "Giving them? To me?" },
    { "s": "a", "ru": "Тебе. Возьми.", "en": "To you. Take them." },
    { "s": "b", "ru": "Возьму. А ты спать?", "en": "I will. And you — to bed?" },
    { "s": "a", "ru": "Спать. Но я ещё готовлю.", "en": "To bed. But I am still cooking." },
    { "s": "b", "ru": "Готовишь и не спишь.", "en": "Cooking and not sleeping." },
    { "s": "a", "ru": "Не сплю, Пётр. Телефон у тебя.", "en": "Not sleeping, Pyotr. You have the telephone." }
   ],
   "questions": [
    { "ask": "What is Nina doing?",
      "options": ["Cooking", "Sleeping", "On the telephone", "Packing"], "answer": 0 },
    { "ask": "Where is her telephone?",
      "options": ["Pyotr has it now", "At the shop still", "In her own hand", "Lost somewhere"], "answer": 0 },
    { "ask": "What does she give him?",
      "options": ["A few things", "The telephone only", "Food", "Nothing"], "answer": 0 },
    { "ask": "Is she going to bed?",
      "options": ["Not yet, still cooking", "She never sleeps at all", "Yes, at once she says", "After Pyotr has left"],
      "answer": 0 },
    { "ask": "Who does most of the asking?",
      "options": ["Pyotr", "Nina", "Both equally", "Neither"], "answer": 0 }
   ]
  },

  "core8:4": {
   "title": "A good day, for today",
   "cast": [    { "id": "a", "ru": "Олег", "en": "Oleg" },
    { "id": "b", "ru": "Виктор", "en": "Viktor" }
   ],
   "lines": [
    { "s": "b", "ru": "Олег, это хороший день?", "en": "Oleg, is this a good day?" },
    { "s": "a", "ru": "Хороший. И ты тоже.", "en": "A good one. And so are you." },
    { "s": "b", "ru": "Я тоже? Хороший?", "en": "Me too? Good?" },
    { "s": "a", "ru": "Хороший. Как и день.", "en": "Good. Like the day." },
    { "s": "b", "ru": "А программа? Она хорошая?", "en": "And the programme? Is that good?" },
    { "s": "a", "ru": "Программа тоже хорошая.", "en": "The programme is good as well." },
    { "s": "b", "ru": "Всё хорошее! И мир?", "en": "Everything is good! And the world?" },
    { "s": "a", "ru": "Мир тоже. Сегодня.", "en": "The world too. Today." },
    { "s": "b", "ru": "Только сегодня?", "en": "Only today?" },
    { "s": "a", "ru": "Только. Завтра не знаю.", "en": "Only. Tomorrow I do not know." },
    { "s": "b", "ru": "Завтра тоже будет хороший день.", "en": "Tomorrow will be a good day too." },
    { "s": "a", "ru": "Может быть, Виктор. Может быть.", "en": "Maybe, Viktor. Maybe." }
   ],
   "questions": [
    { "ask": "What is the mood between them?",
      "options": ["Light and warm", "Formal and stiff", "Tense and cold", "Sad throughout"], "answer": 0 },
    { "ask": "What does Oleg say about Viktor?",
      "options": ["He is good too", "He is quite wrong", "He is late again", "He says nothing"], "answer": 0 },
    { "ask": "How far does his good opinion of the world stretch?",
      "options": ["Only to today", "For ever", "Not at all", "Until the programme ends"],
      "answer": 0 },
    { "ask": "What does Viktor predict?",
      "options": ["Tomorrow will be good too", "Rain for the whole week", "Nothing at all, he says", "Trouble of some kind"], "answer": 0 },    { "ask": "Does he agree?",
      "options": ["Only 'maybe'", "Completely", "Not at all", "He changes the subject"], "answer": 0 }
   ]
  },

  "military:0": {
   "title": "A soldier and his commander",
   "cast": [
    { "id": "a", "ru": "Аня", "en": "Anya" },
    { "id": "b", "ru": "Иван", "en": "Ivan" }
   ],
   "lines": [
    { "s": "b", "ru": "Аня, кто этот человек? Солдат?", "en": "Anya, who is that man? A soldier?" },
    { "s": "a", "ru": "Солдат. Он в армии.", "en": "A soldier. He is in the army." },
    { "s": "b", "ru": "В армии! А командир?", "en": "In the army! And the commander?" },
    { "s": "a", "ru": "Командир тут. Он военный.", "en": "The commander is here. He is a military man." },
    { "s": "b", "ru": "Военный... А война?", "en": "A military man... And the war?" },
    { "s": "a", "ru": "Война была. Но не тут.", "en": "There was a war. But not here." },
    { "s": "b", "ru": "Хорошо, что не тут.", "en": "It is good that it is not here." },
    { "s": "a", "ru": "Хорошо. Есть защита.", "en": "Good. There is a defence." },
    { "s": "b", "ru": "Защита? От кого?", "en": "A defence? Against whom?" },
    { "s": "a", "ru": "От всех. Это борьба.", "en": "Against everyone. It is a struggle." },
    { "s": "b", "ru": "Борьба каждый день?", "en": "A struggle every day?" },
    { "s": "a", "ru": "Каждый день, Иван. Армия работает.", "en": "Every day, Ivan. The army is at work." }
   ],
   "questions": [
    { "ask": "Who is the man?",
      "options": ["A soldier", "The commander", "A veteran", "A civilian"], "answer": 0 },
    { "ask": "Was there a war?",
      "options": ["Yes, but not there", "No", "It is going on there", "Anya will not say"],
      "answer": 0 },
    { "ask": "Who else is there?",
      "options": ["The commander", "Nobody", "The whole army", "A general"], "answer": 0 },
    { "ask": "What is the defence against?",
      "options": ["Everyone", "One enemy", "Nothing in particular", "The weather"], "answer": 0 },
    { "ask": "How often is the struggle?",
      "options": ["Every day", "Once a year", "It is over", "It has not begun"], "answer": 0 }
   ]
  },

  "military:1": {
   "title": "A shot at the front",
   "cast": [
    { "id": "a", "ru": "Катя", "en": "Katya" },    { "id": "b", "ru": "Борис", "en": "Boris" },
    { "id": "c", "ru": "Пётр", "en": "Pyotr" }
   ],
   "lines": [
    { "s": "b", "ru": "Катя, ты слышала выстрел?", "en": "Katya, did you hear a shot?" },
    { "s": "a", "ru": "Выстрел? Слышала. Это фронт.", "en": "A shot? I heard it. That is the front." },
    { "s": "b", "ru": "Фронт! А противник?", "en": "The front! And the enemy?" },
    { "s": "a", "ru": "Противник там. Не тут.", "en": "The enemy is over there. Not here." },
    { "s": "b", "ru": "Не тут. А оружие?", "en": "Not here. And the weapons?" },
    { "s": "a", "ru": "Оружие есть. И приказ есть.", "en": "There are weapons. And there is an order." },
    { "s": "b", "ru": "Приказ? Какой?", "en": "An order? What order?" },
    { "s": "a", "ru": "Ждать. Только ждать.", "en": "To wait. Only to wait." },
    { "s": "b", "ru": "Ждать... А флот?", "en": "To wait... And the fleet?" },
    { "s": "a", "ru": "Флот идёт. Это победа.", "en": "The fleet is coming. That is victory." },
    { "s": "b", "ru": "Победа! Уже?", "en": "Victory! Already?" },    { "s": "a", "ru": "Уже, Борис. Флот идёт.", "en": "Already, Boris. The fleet is coming." },
    { "s": "c", "ru": "Приказ есть. Флот уже тут.", "en": "There is an order. The fleet is already here." },
    { "s": "b", "ru": "Пётр! Флот тут?", "en": "Pyotr! The fleet is here?" },
    { "s": "c", "ru": "Тут. Это победа.", "en": "Here. That is victory." }
   ],
   "questions": [
    { "ask": "What did they hear?",
      "options": ["A shot", "An aircraft", "Nothing", "The fleet"], "answer": 0 },
    { "ask": "Where is the enemy?",
      "options": ["Some way off", "Right there", "Behind them", "Nobody knows"], "answer": 0 },
    { "ask": "What is the order?",
      "options": ["To wait", "To attack", "To retreat", "There is none"], "answer": 0 },
    { "ask": "What changes things?",
      "options": ["The fleet is coming", "The enemy retreats", "A new commander", "Nothing"],
      "answer": 0 },    { "ask": "Who confirms the fleet has arrived?",
      "options": ["Pyotr", "Katya", "Boris", "Nobody does"], "answer": 0 }
   ]
  },

  "military:2": {
   "title": "The captain is a veteran",
   "cast": [
    { "id": "a", "ru": "Лена", "en": "Lena" },
    { "id": "b", "ru": "Юра", "en": "Yura" }
   ],
   "lines": [
    { "s": "b", "ru": "Лена, кто этот капитан?", "en": "Lena, who is that captain?" },
    { "s": "a", "ru": "Капитан? Он ветеран.", "en": "The captain? He is a veteran." },
    { "s": "b", "ru": "Ветеран! Он много боролся.", "en": "A veteran! He has fought a great deal." },
    { "s": "a", "ru": "Боролся. И победа была.", "en": "He has. And there was a victory." },
    { "s": "b", "ru": "А поражение? Оно было?", "en": "And a defeat? Was there one?" },
    { "s": "a", "ru": "Было. Один раз.", "en": "There was. Once." },
    { "s": "b", "ru": "Один раз... А враг?", "en": "Once... And the enemy?" },
    { "s": "a", "ru": "Враг теперь не тут.", "en": "The enemy is not here now." },
    { "s": "b", "ru": "Не тут. А пуля? И мина?", "en": "Not here. And a bullet? And a mine?" },
    { "s": "a", "ru": "Пуля была. Мина тоже.", "en": "There was a bullet. And a mine." },
    { "s": "b", "ru": "И капитан тут!", "en": "And the captain is still here!" },
    { "s": "a", "ru": "Тут, Юра. Он ветеран.", "en": "Here, Yura. He is a veteran." }
   ],
   "questions": [
    { "ask": "Who are they talking about?",
      "options": ["A captain who is a veteran", "A very young soldier there", "The enemy, somewhere else", "A general in the regiment"],
      "answer": 0 },
    { "ask": "How many defeats has he had?",
      "options": ["One", "None", "Many", "Lena does not know"], "answer": 0 },
    { "ask": "Where is the enemy now?",
      "options": ["Gone from there", "Close by", "In the fortress", "Unknown"], "answer": 0 },
    { "ask": "What has he survived?",
      "options": ["A bullet and a mine", "Nothing", "Only a mine", "A whole war unharmed"],
      "answer": 0 },
    { "ask": "What is remarkable to Yura?",
      "options": ["That he is still there", "That he is a captain", "That he lost once", "Nothing"],
      "answer": 0 }
   ]
  },

  "military:3": {
   "title": "The colonel gave the order",
   "cast": [
    { "id": "a", "ru": "Нина", "en": "Nina" },
    { "id": "b", "ru": "Миша", "en": "Misha" }
   ],
   "lines": [
    { "s": "b", "ru": "Нина, что за атака?", "en": "Nina, what is this attack?" },
    { "s": "a", "ru": "Атака? Это наступление.", "en": "An attack? It is an offensive." },
    { "s": "b", "ru": "Наступление! Кто приказал?", "en": "An offensive! Who ordered it?" },
    { "s": "a", "ru": "Полковник. Он тут главный.", "en": "The colonel. He is in charge here." },
    { "s": "b", "ru": "Полковник... А офицеры?", "en": "The colonel... And the officers?" },
    { "s": "a", "ru": "Офицеры в полку. Все.", "en": "The officers are with the regiment. All of them." },
    { "s": "b", "ru": "Весь полк? А пистолет?", "en": "The whole regiment? And the pistol?" },
    { "s": "a", "ru": "Пистолет у офицера.", "en": "The officer has the pistol." },
    { "s": "b", "ru": "У офицера... И что теперь?", "en": "The officer has it... And now what?" },
    { "s": "a", "ru": "Теперь ждём. Он приказал ждать.", "en": "Now we wait. He ordered us to wait." },
    { "s": "b", "ru": "Приказал ждать, а атака идёт.", "en": "Ordered you to wait, and the attack is going on." },
    { "s": "a", "ru": "Идёт, Миша. Наступление идёт быстро.", "en": "It is, Misha. The offensive is moving fast." }
   ],
   "questions": [
