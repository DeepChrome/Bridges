{
 "chapter": 9,
 "name": "Where, When & How",
 "lessons": {
  "core9:0": {
   "title": "On the other side",
   "cast": [
    { "id": "a", "ru": "Аня", "en": "Anya" },    { "id": "b", "ru": "Соня", "en": "Sonya" }
   ],
   "lines": [
    { "s": "b", "ru": "Аня, где это? Тут?", "en": "Anya, where is it? Here?" },
    { "s": "a", "ru": "Тут. Около нас.", "en": "Here. Right by us." },
    { "s": "b", "ru": "Около? Я не вижу.", "en": "By us? I cannot see it." },
    { "s": "a", "ru": "Вот, с другой стороны.", "en": "There, on the other side." },
    { "s": "b", "ru": "С другой стороны! А второй дом?", "en": "On the other side! And the second house?" },
    { "s": "a", "ru": "Второй. Он против первого.", "en": "The second. It is opposite the first." },
    { "s": "b", "ru": "Против... Ты идёшь слишком быстро.", "en": "Opposite... You are walking too fast." },
    { "s": "a", "ru": "Быстро. А ты смотри на землю.", "en": "Fast. And you watch the ground." },
    { "s": "b", "ru": "На землю? Почему?", "en": "The ground? Why?" },
    { "s": "a", "ru": "Там вода. Ты не видишь.", "en": "There is water there. You are not looking." },
    { "s": "b", "ru": "Не вижу. Я смотрю на дом.", "en": "I am not. I am looking at the house." },
    { "s": "a", "ru": "На дом. А я на землю, Соня.", "en": "At the house. And I at the ground, Sonya." }
   ],
   "questions": [
    { "ask": "Where is the place they want?",
      "options": ["On the other side", "Straight ahead", "Behind them", "They never find it"],
      "answer": 0 },
    { "ask": "Where is the second house?",
      "options": ["Opposite the first", "Next to the first", "Further on", "There is no second house"],
      "answer": 0 },    { "ask": "What does Anya complain about?",
      "options": ["Sonya walks too fast", "Sonya is too slow", "Sonya will not talk", "The house"], "answer": 0 },    { "ask": "Why should Sonya look down?",
      "options": ["There is water on the ground", "It is dark", "She dropped something", "No reason is given"],
      "answer": 0 },
    { "ask": "What is Sonya looking at instead?",
      "options": ["The house", "The ground", "Anya", "Nothing"], "answer": 0 }
   ]
  },

  "core9:1": {
   "title": "Something between them",
   "cast": [
    { "id": "a", "ru": "Катя", "en": "Katya" },
    { "id": "b", "ru": "Борис", "en": "Boris" }
   ],
   "lines": [
    { "s": "b", "ru": "Катя, ты идёшь?", "en": "Katya, are you coming?" },
    { "s": "a", "ru": "Иду. Почти готова.", "en": "I am. Almost ready." },
    { "s": "b", "ru": "Почти! А между нами...", "en": "Almost! And between us..." },
    { "s": "a", "ru": "Между нами? Что?", "en": "Between us? What?" },
    { "s": "b", "ru": "Необходимо сказать одно.", "en": "There is one thing that has to be said." },
    { "s": "a", "ru": "Скажи. Иногда это лучше.", "en": "Say it. Sometimes that is better." },
    { "s": "b", "ru": "Лучше? Тогда в любой день.", "en": "Better? Any day will do, then." },
    { "s": "a", "ru": "В любой? Я слушаю.", "en": "Any day? I am listening." },
    { "s": "b", "ru": "Спасибо. Это между нами.", "en": "Thank you. This is between us." },
    { "s": "a", "ru": "Между нами, Борис. Всегда.", "en": "Between us, Boris. Always." },
    { "s": "b", "ru": "Всегда? Иногда это не так.", "en": "Always? Sometimes it is not." },
    { "s": "a", "ru": "Не так. Но почти всегда.", "en": "Not always. But nearly always." }
   ],
   "questions": [
    { "ask": "Is Katya ready to go?",
      "options": ["Almost", "Yes", "No", "She is not going"], "answer": 0 },
    { "ask": "What does Boris want?",
      "options": ["To say something to her", "To leave", "An answer to a question", "Nothing"],
      "answer": 0 },
    { "ask": "How does she respond?",
      "options": ["She tells him to say it", "She refuses", "She walks off", "She changes the subject"],
      "answer": 0 },
    { "ask": "What does he say it is?",
      "options": ["Between the two of them", "Public knowledge", "A joke", "Urgent"], "answer": 0 },
    { "ask": "Does she promise it will stay between them?",
      "options": ["Nearly always, she says", "Absolutely never", "She will not promise", "She tells him it will not"],
      "answer": 0 }
   ]
  },

  "core9:2": {
   "title": "The result comes later",
   "cast": [
    { "id": "a", "ru": "Лена", "en": "Lena" },    { "id": "b", "ru": "Юра", "en": "Yura" },
    { "id": "c", "ru": "Маша", "en": "Masha" }
   ],
   "lines": [
    { "s": "b", "ru": "Лена, откуда ты это знаешь?", "en": "Lena, how do you know that?" },
    { "s": "a", "ru": "Откуда? Я понимаю.", "en": "How? I understand it." },
    { "s": "b", "ru": "Понимаешь? Ну хорошо.", "en": "You understand? Well, all right." },
    { "s": "a", "ru": "Ну? Ты не понимаешь?", "en": "Well? Do you not understand?" },
    { "s": "b", "ru": "Понимаю. Но результат?", "en": "I do. But the result?" },
    { "s": "a", "ru": "Результат будет потом.", "en": "The result comes later." },
    { "s": "b", "ru": "Потом! А три дня?", "en": "Later! And three days?" },
    { "s": "a", "ru": "Три дня — это тоже потом.", "en": "Three days is later too." },
    { "s": "b", "ru": "Тоже потом... А вид?", "en": "Later as well... And the view?" },
    { "s": "a", "ru": "Вид хороший. Я его люблю.", "en": "The view is good. I love it." },
    { "s": "b", "ru": "Любишь вид, а результат?", "en": "You love the view — and the result?" },    { "s": "a", "ru": "Результат потом, Юра. Я понимаю.", "en": "The result comes later, Yura. I understand it." },
    { "s": "c", "ru": "Результат тут. Я его знаю.", "en": "The result is here. I know it." },
    { "s": "b", "ru": "Маша? Откуда ты знаешь?", "en": "Masha? How do you know?" },
    { "s": "c", "ru": "Понимаю. Как Лена.", "en": "I understand it. Like Lena." }
   ],
   "questions": [
    { "ask": "What does Yura want to know at the start?",
      "options": ["How she knows it", "Where she is", "What the view is", "Whether she is coming"],
      "answer": 0 },
    { "ask": "When will the result come?",
      "options": ["Later", "In an hour", "It already has", "Never"], "answer": 0 },
    { "ask": "How does she treat three days?",
      "options": ["As 'later' too", "As too long", "As too short", "She does not answer"],
      "answer": 0 },
    { "ask": "What does she say about the view?",
      "options": ["She loves it", "It is spoilt", "She cannot see it", "Nothing"], "answer": 0 },    { "ask": "Who turns out to have the result?",
      "options": ["Masha", "Lena", "Yura", "Nobody"], "answer": 0 }
   ]
  },

  "core9:3": {
   "title": "No strength left",
   "cast": [
    { "id": "a", "ru": "Нина", "en": "Nina" },
    { "id": "b", "ru": "Виктор", "en": "Viktor" }
   ],
   "lines": [
    { "s": "b", "ru": "Нина, ты идёшь домой?", "en": "Nina, are you going home?" },
    { "s": "a", "ru": "Домой. Но медленно.", "en": "Home. But slowly." },
    { "s": "b", "ru": "Медленно? Почему?", "en": "Slowly? Why?" },
    { "s": "a", "ru": "Нет силы. Уже день.", "en": "No strength left. It has been a whole day." },
    { "s": "b", "ru": "Нет силы... А ты остаёшься?", "en": "No strength... And are you staying?" },
    { "s": "a", "ru": "Остаюсь. Ещё час.", "en": "I am staying. Another hour." },
    { "s": "b", "ru": "Час! А потом всё проходит?", "en": "An hour! And then it all passes?" },
    { "s": "a", "ru": "Проходит. Всегда проходит.", "en": "It passes. It always passes." },
    { "s": "b", "ru": "А что ты получаешь?", "en": "And what do you get out of it?" },
    { "s": "a", "ru": "Получаю? Ничего. Только работу.", "en": "Get? Nothing. Only the work." },
    { "s": "b", "ru": "Только работу! И вдруг силу?", "en": "Only the work! And suddenly, strength?" },
    { "s": "a", "ru": "И силу, Виктор. Иногда.", "en": "And strength, Viktor. Sometimes." }
   ],
   "questions": [
    { "ask": "Why is Nina moving slowly?",
      "options": ["She has no strength left", "It is dark", "She is not in a hurry", "Her leg hurts"],
      "answer": 0 },
    { "ask": "Is she going home now?",
      "options": ["Not for another hour", "Yes, at once", "She is staying all night", "She has already gone"],
      "answer": 0 },
    { "ask": "What does she say about the tiredness?",
      "options": ["It always passes", "It never passes", "It is getting worse", "She does not notice it"],
      "answer": 0 },
    { "ask": "What does she get out of the work?",
      "options": ["Nothing but the work itself", "Good money", "Praise", "Time off"], "answer": 0 },
    { "ask": "Does she ever get strength from it?",
      "options": ["Sometimes", "Never", "Always", "Only at home"], "answer": 0 }
   ]
  },

  "core9:4": {
   "title": "Taking the day as it is",
   "cast": [
    { "id": "a", "ru": "Соня", "en": "Sonya" },
    { "id": "b", "ru": "Пётр", "en": "Pyotr" }
   ],
   "lines": [
    { "s": "b", "ru": "Соня, тебе плохо?", "en": "Sonya, are you feeling bad?" },
    { "s": "a", "ru": "Плохо. Уже час.", "en": "Bad. For an hour now." },
    { "s": "b", "ru": "Час! А ты принимаешь помощь?", "en": "An hour! And do you accept help?" },
    { "s": "a", "ru": "Принимаю. Иногда.", "en": "I do. Sometimes." },
    { "s": "b", "ru": "Иногда? Это плохо.", "en": "Sometimes? That is bad." },
    { "s": "a", "ru": "Плохо. Но я работаю.", "en": "Bad. But I work." },
    { "s": "b", "ru": "Работаешь, когда плохо!", "en": "You work when you feel bad!" },
    { "s": "a", "ru": "Работаю. Так я принимаю день.", "en": "I do. That is how I take the day." },
    { "s": "b", "ru": "Принимаешь день... Понимаю.", "en": "You take the day... I see." },
    { "s": "a", "ru": "Понимаешь? Спасибо, Пётр.", "en": "You see? Thank you, Pyotr." },
    { "s": "b", "ru": "А завтра? Будет лучше?", "en": "And tomorrow? Will it be better?" },
    { "s": "a", "ru": "Будет. Всегда лучше.", "en": "It will. It is always better." }
   ],
   "questions": [
    { "ask": "How is Sonya feeling?",
      "options": ["Bad, for the last hour", "Perfectly well", "Tired but happy", "She will not say"],
      "answer": 0 },
    { "ask": "Does she accept help?",
      "options": ["Only sometimes", "Always", "Never", "Only from Pyotr"], "answer": 0 },
    { "ask": "What does she do when she feels bad?",
      "options": ["Works anyway", "Goes home", "Sleeps", "Asks for help"], "answer": 0 },
    { "ask": "How does Pyotr respond?",
      "options": ["He says he understands", "He tells her off", "He leaves", "He laughs"],
      "answer": 0 },
    { "ask": "What does she expect of tomorrow?",
      "options": ["It will be better", "It will be worse", "The same", "She has not thought about it"],
      "answer": 0 }
   ]
  },

