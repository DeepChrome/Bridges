  "core10:0": {
   "title": "Always here, always alone",
   "cast": [
    { "id": "a", "ru": "Аня", "en": "Anya" },
    { "id": "b", "ru": "Борис", "en": "Boris" }
   ],
   "lines": [
    { "s": "b", "ru": "Аня, ты тут постоянно?", "en": "Anya, are you here all the time?" },
    { "s": "a", "ru": "Постоянно. Уже примерно год.", "en": "All the time. For about a year now." },
    { "s": "b", "ru": "Год! А это часть работы?", "en": "A year! And is that part of the job?" },
    { "s": "a", "ru": "Часть. И самая большая.", "en": "Part of it. And the biggest part." },
    { "s": "b", "ru": "Большая! А конец?", "en": "The biggest! And the end of it?" },
    { "s": "a", "ru": "Конец будет. Однажды.", "en": "There will be an end. One day." },
    { "s": "b", "ru": "Однажды... А рядом кто?", "en": "One day... And who is there with you?" },
    { "s": "a", "ru": "Рядом никто. Только я.", "en": "Nobody. Only me." },
    { "s": "b", "ru": "Только ты! Нельзя так.", "en": "Only you! You cannot go on like that." },
    { "s": "a", "ru": "Нельзя? Я так работаю.", "en": "Cannot? That is how I work." },
    { "s": "b", "ru": "Постоянно одна... Это нельзя.", "en": "Alone all the time... That will not do." },
    { "s": "a", "ru": "Можно, Борис. Однажды будет конец.", "en": "It will do, Boris. One day it will end." }
   ],
   "questions": [
    { "ask": "How long has Anya been at it?",
      "options": ["About a year", "A month", "Since yesterday", "She does not say"], "answer": 0 },
    { "ask": "How much of the job is it?",
      "options": ["The biggest part", "A small part", "All of it", "None of it"], "answer": 0 },
    { "ask": "Who is there with her?",
      "options": ["Nobody", "Boris", "A colleague", "Several people"], "answer": 0 },
    { "ask": "What does Boris think of that?",
      "options": ["She cannot go on like that", "It is admirable", "It is normal", "He says nothing"],
      "answer": 0 },
    { "ask": "How does she answer him?",
      "options": ["It will end one day", "She agrees to stop", "She asks for help", "She is angry"],
      "answer": 0 }
   ]
  },

  "core10:1": {
   "title": "The ones who come early",
   "cast": [
    { "id": "a", "ru": "Катя", "en": "Katya" },    { "id": "b", "ru": "Миша", "en": "Misha" },
    { "id": "c", "ru": "Олег", "en": "Oleg" }
   ],
   "lines": [
    { "s": "b", "ru": "Катя, ты рано начинаешь?", "en": "Katya, do you start early?" },
    { "s": "a", "ru": "Рано. Каждый день.", "en": "Early. Every day." },
    { "s": "b", "ru": "Каждый день! А возможность?", "en": "Every day! And the opportunity?" },
    { "s": "a", "ru": "Возможность есть. Лишь одна.", "en": "There is an opportunity. Only one." },
    { "s": "b", "ru": "Лишь одна? Какая?", "en": "Only one? What is it?" },
    { "s": "a", "ru": "Некоторые приходят рано. Я тоже.", "en": "Some people come early. So do I." },
    { "s": "b", "ru": "Приходят... И ты считаешь это работой?", "en": "They come... And you count that as work?" },
    { "s": "a", "ru": "Считаю. Это работа.", "en": "I do. It is work." },
    { "s": "b", "ru": "Работа! А некоторые считают не так.", "en": "Work! And some think otherwise." },
    { "s": "a", "ru": "Не так. Но они не приходят.", "en": "Otherwise. But they do not come." },
    { "s": "b", "ru": "Не приходят! Тогда у тебя возможность.", "en": "They do not come! Then the opportunity is yours." },    { "s": "a", "ru": "Возможность, Миша. Я начинаю рано.", "en": "The opportunity, Misha. I start early." },
    { "s": "c", "ru": "Я тоже прихожу рано.", "en": "I come early too." },
    { "s": "b", "ru": "Олег! И ты?", "en": "Oleg! You as well?" },
    { "s": "c", "ru": "И я. Это работа.", "en": "Me as well. It is work." }
   ],
   "questions": [
    { "ask": "When does Katya start?",
      "options": ["Early, every day", "Late", "Only when asked", "She does not say"], "answer": 0 },
    { "ask": "What is the one opportunity?",
      "options": ["Being one of the few who come early", "A promotion", "A new job", "More pay"],
      "answer": 0 },
    { "ask": "Does she count it as work?",
      "options": ["Yes", "No", "Only sometimes", "Misha does"], "answer": 0 },
    { "ask": "What do the others do?",
      "options": ["They do not come", "They come later", "They argue", "They work harder"],
      "answer": 0 },    { "ask": "Who else comes in early?",
      "options": ["Oleg", "Misha", "Nobody", "Everyone does"], "answer": 0 }
   ]
  },

  "core10:2": {
   "title": "That is the system",
   "cast": [
    { "id": "a", "ru": "Лена", "en": "Lena" },
    { "id": "b", "ru": "Олег", "en": "Oleg" }
   ],
   "lines": [
    { "s": "b", "ru": "Лена, почему ты выходишь?", "en": "Lena, why are you going out?" },
    { "s": "a", "ru": "Выхожу? Приходится.", "en": "Going out? I have to." },
    { "s": "b", "ru": "Приходится! Почему именно сейчас?", "en": "You have to! Why just now?" },
    { "s": "a", "ru": "Именно сейчас. Поэтому и выхожу.", "en": "Precisely now. That is why I am going." },
    { "s": "b", "ru": "Поэтому... А система?", "en": "That is why... And the system?" },
    { "s": "a", "ru": "Система тут такая. Всегда была.", "en": "That is the system here. It always was." },
    { "s": "b", "ru": "Была! А образ работы?", "en": "It was! And the way of working?" },
    { "s": "a", "ru": "Образ работы другой. Также и дело.", "en": "The way of working is different. So is the business." },
    { "s": "b", "ru": "И дело! Так что же?", "en": "The business too! So what then?" },
    { "s": "a", "ru": "Так что приходится выходить.", "en": "So I have to go out." },
    { "s": "b", "ru": "Выходить... Именно поэтому?", "en": "Go out... For exactly that reason?" },
    { "s": "a", "ru": "Именно, Олег. Такая система.", "en": "Exactly, Oleg. That is the system." }
   ],
   "questions": [
    { "ask": "Why is Lena going out?",
      "options": ["She has to", "She wants to", "Oleg asked her", "To avoid him"], "answer": 0 },
    { "ask": "What does she blame?",
      "options": ["The system", "Oleg", "The weather", "Herself"], "answer": 0 },
    { "ask": "Has the system changed?",
      "options": ["No, it always was like that", "Yes, recently", "It is about to", "She does not know"],
      "answer": 0 },
    { "ask": "What is different?",
      "options": ["The way of working", "The system", "The people", "Nothing"], "answer": 0 },
    { "ask": "How does Oleg take it?",
      "options": ["He keeps pressing for the reason", "He accepts it at once", "He goes with her", "He is angry"],
      "answer": 0 }
   ]
  },

  "core10:3": {
   "title": "Answering all the same",
   "cast": [    { "id": "a", "ru": "Иван", "en": "Ivan" },
    { "id": "b", "ru": "Пётр", "en": "Pyotr" }
   ],
   "lines": [
    { "s": "b", "ru": "Иван, ты отвечаешь?", "en": "Ivan, are you answering?" },
    { "s": "a", "ru": "Отвечаю. Конечно.", "en": "I am. Of course." },
    { "s": "b", "ru": "Конечно! Хотя вопрос большой.", "en": "Of course! Though it is a big question." },
    { "s": "a", "ru": "Большой. Однако я отвечаю.", "en": "Big. However, I am answering it." },
    { "s": "b", "ru": "Есть! А отношение?", "en": "There is! And your attitude?" },
    { "s": "a", "ru": "Отношение у меня хорошее.", "en": "My attitude is a good one." },
    { "s": "b", "ru": "Хорошее! А вообще?", "en": "Good! And in general?" },
    { "s": "a", "ru": "Вообще ничто не идёт.", "en": "In general, nothing is moving." },
    { "s": "b", "ru": "Не идёт! Хотя ты работаешь.", "en": "Not moving! Though you are working." },
    { "s": "a", "ru": "Работаю. Однако результата нет.", "en": "I am working. However, there is no result." },
    { "s": "b", "ru": "Нет результата... И ты отвечаешь?", "en": "No result... And you still answer?" },
    { "s": "a", "ru": "Отвечаю, Пётр. Конечно, отвечаю.", "en": "I answer, Pyotr. Of course I answer." }
   ],
   "questions": [
    { "ask": "What is Ivan doing?",
      "options": ["Answering questions", "Asking them", "Refusing to speak", "Leaving"],
      "answer": 0 },    { "ask": "How does he describe his attitude?",
      "options": ["Good", "Poor", "Indifferent", "He does not say"], "answer": 0 },
    { "ask": "What does he say about progress?",
      "options": ["Nothing is moving", "It is going well", "It is nearly finished", "It is not her concern"],
      "answer": 0 },    { "ask": "Does his work show a result?",
      "options": ["No", "Yes", "Only a small one", "He will not say"], "answer": 0 },    { "ask": "Does he stop answering?",
      "options": ["No, he keeps answering", "Yes", "He answers once more", "He asks Pyotr to stop"],
      "answer": 0 }
   ]
  },

  "core10:4": {
   "title": "She is the one deciding",
   "cast": [
    { "id": "a", "ru": "Соня", "en": "Sonya" },
    { "id": "b", "ru": "Виктор", "en": "Viktor" }
   ],
   "lines": [
    { "s": "b", "ru": "Соня, кто решает?", "en": "Sonya, who decides?" },
    { "s": "a", "ru": "Решаю я. Как всегда.", "en": "I decide. As always." },
    { "s": "b", "ru": "Всегда! И это становится системой.", "en": "Always! And it is becoming a system." },
    { "s": "a", "ru": "Становится. Но я решаю.", "en": "It is. But I decide." },
    { "s": "b", "ru": "Решаешь... А если нельзя?", "en": "You decide... And if you cannot?" },
    { "s": "a", "ru": "Тогда тоже решаю.", "en": "Then I decide as well." },
    { "s": "b", "ru": "Тоже! И что становится?", "en": "As well! And what becomes of it?" },
    { "s": "a", "ru": "Становится лучше. Примерно так.", "en": "It gets better. More or less." },
    { "s": "b", "ru": "Примерно! Хотя ты одна.", "en": "More or less! Though you are on your own." },
    { "s": "a", "ru": "Одна. Но я решаю.", "en": "On my own. But I decide." },
    { "s": "b", "ru": "Решаешь, и всё становится...", "en": "You decide, and everything becomes..." },
    { "s": "a", "ru": "Всё становится, Виктор. Однажды.", "en": "Everything becomes something, Viktor. One day." }
   ],
   "questions": [
    { "ask": "Who makes the decisions?",
      "options": ["Sonya", "Viktor", "Nobody", "They take turns"], "answer": 0 },
    { "ask": "What does Viktor call it?",
      "options": ["A system", "A mistake", "A habit of his", "Good work"], "answer": 0 },
    { "ask": "What happens when she is not allowed to?",
      "options": ["She decides anyway", "She waits", "She asks Viktor", "Nothing happens"],
      "answer": 0 },
    { "ask": "Does it get better?",
      "options": ["More or less", "No", "Much worse", "She cannot tell"], "answer": 0 },
    { "ask": "What does Viktor point out about her?",
      "options": ["She is on her own", "She is wrong", "She is too slow", "She is new"],
      "answer": 0 }
   ]
  },

  "law:0": {
   "title": "An unlawful agreement",
   "cast": [
    { "id": "a", "ru": "Аня", "en": "Anya" },
    { "id": "b", "ru": "Иван", "en": "Ivan" }
   ],
   "lines": [
    { "s": "b", "ru": "Аня, это суд?", "en": "Anya, is this a court?" },
    { "s": "a", "ru": "Суд. Тут закон.", "en": "A court. The law is here." },
    { "s": "b", "ru": "Закон! А преступник?", "en": "The law! And the offender?" },
    { "s": "a", "ru": "Преступник тут. Полиция его взяла.", "en": "The offender is here. The police took him." },
    { "s": "b", "ru": "Полиция! А договор?", "en": "The police! And the agreement?" },
    { "s": "a", "ru": "Договор был. Но он незаконный.", "en": "There was an agreement. But it is unlawful." },
    { "s": "b", "ru": "Незаконный договор! И что теперь?", "en": "An unlawful agreement! And now what?" },
    { "s": "a", "ru": "Теперь суд решает.", "en": "Now the court decides." },
    { "s": "b", "ru": "Решает... А он убил?", "en": "Decides... And did he kill anyone?" },
    { "s": "a", "ru": "Нет. Он не убил.", "en": "No. He did not." },
    { "s": "b", "ru": "Не убил! Тогда что?", "en": "He did not! Then what is it?" },
    { "s": "a", "ru": "Договор, Иван. Незаконный договор.", "en": "The agreement, Ivan. An unlawful agreement." }
   ],
   "questions": [
    { "ask": "Where are they?",
      "options": ["At a court", "At a police station", "At a prison", "At an office"], "answer": 0 },
    { "ask": "Who took the man in?",
      "options": ["The police", "The court", "Nobody", "Anya does not say"], "answer": 0 },
    { "ask": "What is the case about?",
      "options": ["An unlawful agreement", "A killing", "A theft", "A bribe"], "answer": 0 },
    { "ask": "Did he kill anyone?",
      "options": ["No", "Yes", "It is not known", "That is the charge"], "answer": 0 },
    { "ask": "Who decides now?",
      "options": ["The court", "The police", "Anya", "Nobody"], "answer": 0 }
   ]
  },

  "law:1": {
   "title": "The judge decides the punishment",
   "cast": [
    { "id": "a", "ru": "Катя", "en": "Katya" },
    { "id": "b", "ru": "Борис", "en": "Boris" }
   ],
   "lines": [
    { "s": "b", "ru": "Катя, кто судья?", "en": "Katya, who is the judge?" },
    { "s": "a", "ru": "Судья? Он тут. Слушает.", "en": "The judge? He is here. Listening." },
    { "s": "b", "ru": "Слушает! А преступление?", "en": "Listening! And the crime?" },
    { "s": "a", "ru": "Преступление было. Но не убийство.", "en": "There was a crime. But not a murder." },
    { "s": "b", "ru": "Не убийство! А виновный?", "en": "Not a murder! And the guilty party?" },
    { "s": "a", "ru": "Виновный есть. Он в суде.", "en": "There is one. He is in court." },
    { "s": "b", "ru": "В суде... А наказание?", "en": "In court... And the punishment?" },
    { "s": "a", "ru": "Наказание будет. Юридический вопрос.", "en": "There will be a punishment. It is a legal question." },
    { "s": "b", "ru": "Юридический! А тюрьма?", "en": "Legal! And prison?" },
    { "s": "a", "ru": "Тюрьма? Может быть. Судья решает.", "en": "Prison? Perhaps. The judge decides." },
    { "s": "b", "ru": "Судья решает... Всегда он?", "en": "The judge decides... Always him?" },
    { "s": "a", "ru": "Всегда, Борис. Это закон.", "en": "Always, Boris. That is the law." }
   ],
   "questions": [
    { "ask": "What is the judge doing?",
      "options": ["Listening", "Sentencing", "Away", "Speaking to Katya"], "answer": 0 },
    { "ask": "Was it a murder?",
      "options": ["No", "Yes", "Nobody knows", "That is what is being decided"], "answer": 0 },
    { "ask": "Is there a guilty party?",
      "options": ["Yes, and he is in court", "No", "He has fled", "There are several"],
      "answer": 0 },
    { "ask": "Will there be prison?",
      "options": ["Perhaps — the judge decides", "Certainly", "Certainly not", "It is already settled"],
      "answer": 0 },
    { "ask": "Who always decides?",
      "options": ["The judge", "The police", "The public", "It varies"], "answer": 0 }
   ]
  },

