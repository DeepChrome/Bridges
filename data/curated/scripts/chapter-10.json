  "law:4": {
   "title": "The detective found bribes",
   "cast": [
    { "id": "a", "ru": "Соня", "en": "Sonya" },    { "id": "b", "ru": "Маша", "en": "Masha" }
   ],
   "lines": [
    { "s": "b", "ru": "Соня, кто этот юрист?", "en": "Sonya, who is that lawyer?" },
    { "s": "a", "ru": "Юрист? Он работает тут.", "en": "The lawyer? He works here." },
    { "s": "b", "ru": "Тут! А уголовное дело?", "en": "Here! And the criminal case?" },
    { "s": "a", "ru": "Уголовное дело есть. Большое.", "en": "There is a criminal case. A big one." },
    { "s": "b", "ru": "Большое! А взятка?", "en": "A big one! And the bribe?" },
