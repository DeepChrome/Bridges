# Copy to native/.env (gitignored). Expo inlines EXPO_PUBLIC_* at bundle time.
# For EAS builds set the same on the build profile's environment.
EXPO_PUBLIC_FEEDBACK_URL=https://bridges-feedback.<account>.workers.dev

# Optional, and ONLY for a build that never leaves this machine: the owner's
# APP_TOKEN. It is compiled in as plain text. Leave it unset for any build
# handed to anyone — the app then registers for a token of its own on first
# use (ROADMAP 13.39).
# EXPO_PUBLIC_APP_TOKEN=the-same-long-random-string-given-to-wrangler-secret-put-APP_TOKEN
