{
  "expo": {
    "name": "Bridges",
    "slug": "native",
    "version": "1.0.0-beta.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Bridges listens to you read Russian sentences aloud so it can check the words you said. Audio stays on the device; only the words recognised are checked.",
        "NSSpeechRecognitionUsageDescription": "Bridges recognises the Russian you say, on the device, to check the words against the sentence."
      }
    },
    "android": {
      "package": "app.bridges.russian",
      "versionCode": 6,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#4D45E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-speech-recognition",
      "expo-sharing",
      "expo-sqlite",
      "expo-font",
      "expo-asset",
      "expo-notifications",
      "./plugins/withUploadSigning"
    ],
    "extra": {
      "eas": {
        "projectId": "a1211d89-3433-4da8-85a9-6bca368b80ee"
      }
    },
    "owner": "akromah"
  }
}
